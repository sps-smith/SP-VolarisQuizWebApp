<Project>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/.codex-build/**;**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CodexBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(CodexBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CodexBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
