        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify({ isActive: shouldActivate })
    });
    if (resp.ok) location.reload();
    else alert('Failed to update user status.');
}

