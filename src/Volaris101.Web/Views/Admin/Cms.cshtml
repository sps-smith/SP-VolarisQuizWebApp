                        <div style="font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#777">Preview</div>
                        <div style="font-size:13px;color:#666">Review what will move before running the merge.</div>
                    </div>
                    <button class="rbtn" id="merge-preview-btn" onclick="previewBulkMerge()">Preview merge</button>
                </div>
                <div id="merge-preview-panel"></div>
            </section>
            <div class="access-edit-footer" style="margin-top:18px">
