function selectImpersonationUser(radio) {
    if (!radio) return;

    selectedImpersonationUser = {
        userId: radio.dataset.userId,
        userName: radio.dataset.userName || 'this user',
        isActive: radio.dataset.isActive === 'true'
    };
    updateImpersonationButtonState();
}

function resetImpersonationSelection() {
    selectedImpersonationUser = null;
    document.querySelectorAll('input[name="impersonate-user"]').forEach(radio => {
        radio.checked = false;
    });
    updateImpersonationButtonState();
}

function updateImpersonationButtonState() {
    const button = document.getElementById('impersonate-selected-btn');
    if (!button) return;

    const selected = selectedImpersonationUser;
    const canImpersonate = !!selected?.userId && selected.isActive;
    button.disabled = !canImpersonate;
    button.title = canImpersonate
        ? `Impersonate ${selected.userName}`
        : selected?.userId
            ? 'Select an active user to impersonate.'
            : 'Select a user to impersonate.';
}

async function impersonateSelectedUser() {
    if (!selectedImpersonationUser?.userId) {
        alert('Select a user first.');
        return;
    }

    if (!selectedImpersonationUser.isActive) {
        alert('Only active users can be impersonated.');
        return;
    }

    const button = document.getElementById('impersonate-selected-btn');
    if (button?.dataset.busy === 'true')
        return;

    const userName = selectedImpersonationUser.userName || 'this user';
    if (!confirm(`Impersonate ${userName}?\n\nYou will switch into that user's session until you stop impersonation.`)) return;

    if (button)
        button.dataset.busy = 'true';

    try {
        const form = new FormData();
        form.append('returnUrl', `${window.location.pathname}${window.location.search}`);

        const resp = await fetch(`/impersonation/start/${selectedImpersonationUser.userId}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': TOKEN },
            body: form
        });

        if (!resp.ok) {
            alert(await responseErrorMessage(resp, 'Failed to start impersonation.'));
            return;
        }

        const payload = await resp.json();
        window.location.href = payload.redirectUrl || '/';
    } finally {
        if (button)
            button.dataset.busy = 'false';
    }
}

