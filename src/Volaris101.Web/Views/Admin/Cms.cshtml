async function loadQuestion(questionId, lang = '') {
    const query = lang ? `?lang=${encodeURIComponent(lang)}` : '';
    const resp = await fetch(`/admin/cms/question/${questionId}${query}`, { headers: { Accept: 'application/json' } });
    if (!resp.ok) throw new Error('Failed to load question.');
    return await resp.json();
}

function openAnswerModal(questionId, optionId = '', lang = '') {
    loadQuestion(questionId, lang)
        .then(q => {
            const option = optionId ? q.options.find(o => o.optionId === optionId) : null;
            const isNew = !option;
            openModal(`
                <h3 style="font-size:16px;font-weight:700;margin-bottom:16px">${isNew ? 'Add' : 'Edit'} answer</h3>
                <div class="fg" style="margin-bottom:14px">
                    <label class="fl2">Answer text</label>
                    <textarea class="fi" id="answer-text" rows="3" style="width:100%;margin-top:4px">${escHtml(option?.optionText ?? '')}</textarea>
                </div>
                <label style="display:flex;gap:8px;align-items:center;margin-bottom:20px;font-size:13px">
                    <input type="checkbox" id="answer-correct" ${option?.isCorrect ? 'checked' : ''}> Correct answer
                </label>
                <div style="display:flex;gap:10px;justify-content:flex-end">
                    <button class="bex" onclick="openSelectedQuizEditor()">Back to quiz</button>
                    <button class="bec" onclick="saveAnswer('${questionId}', '${optionId}', '${lang}')">Save answer</button>
                </div>`);
        })
        .catch(() => alert('Failed to load answer.'));
}

async function saveAnswer(questionId, optionId = '', lang = '') {
    try {
        const q = await loadQuestion(questionId, lang);
        const text = document.getElementById('answer-text').value.trim();
        const isCorrect = document.getElementById('answer-correct').checked;
        if (!text) { alert('Answer text is required.'); return; }

        const options = [...(q.options ?? [])];
        const idx = optionId ? options.findIndex(o => o.optionId === optionId) : -1;
        if (idx >= 0) {
            options[idx] = { ...options[idx], optionText: text, isCorrect };
        } else {
            options.push({
                optionId: EMPTY_GUID,
                displayOrder: options.length + 1,
                optionText: text,
                isCorrect
            });
        }

        await saveQuestionPayload({ ...q, options });
        location.reload();
    } catch {
        alert('Failed to save answer.');
    }
}

async function deleteAnswer(questionId, optionId, lang = '') {
    if (!confirm('Delete this answer?')) return;
    try {
        const q = await loadQuestion(questionId, lang);
        const options = (q.options ?? [])
            .filter(o => o.optionId !== optionId)
            .map((o, i) => ({ ...o, displayOrder: i + 1 }));
        await saveQuestionPayload({ ...q, options });
        location.reload();
    } catch {
        alert('Failed to delete answer.');
    }
}

