async function saveQuestion(questionId, quizId, languageCode = '') {
    const text = document.getElementById('q-text').value.trim();
    const isMulti = document.getElementById('q-multi').checked;
    const optRows = document.querySelectorAll('#q-options > div');
    const options = Array.from(optRows).map((row, i) => ({
        optionId: row.dataset.optionId || EMPTY_GUID,
        displayOrder: i + 1,
        optionText: row.querySelectorAll('input')[1].value,
        isCorrect: row.querySelector('input[type=checkbox]').checked
    }));

    const isEdit = !!questionId;
    const dto = { questionId: questionId || EMPTY_GUID, displayOrder: 0, questionText: text, isMultiSelect: isMulti, isActive: true, options, languageCode };
    if (!isEdit) {
        dto.quizId = quizId;
    }
    const url = isEdit ? `/admin/cms/question/${questionId}` : '/admin/cms/question/add';
    const body = isEdit ? JSON.stringify(dto) : JSON.stringify({ quizId, question: dto });
    const method = isEdit ? 'PUT' : 'POST';

    const resp = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body
    });
    if (resp.ok) { closeModal(); location.reload(); }
    else alert(await responseErrorMessage(resp, 'Failed to save question.'));
}

async function saveQuestionPayload(dto) {
    const resp = await fetch(`/admin/cms/question/${dto.questionId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify(dto)
    });
    if (!resp.ok) throw new Error('Failed to save question.');
}

async function deleteQuestion(questionId) {
    if (!confirm('Delete this question?')) return;
    const resp = await fetch(`/admin/cms/question/${questionId}`, {
        method: 'DELETE',
        headers: { 'RequestVerificationToken': TOKEN }
    });
    if (resp.ok) location.reload();
    else alert('Failed to delete question.');
}

