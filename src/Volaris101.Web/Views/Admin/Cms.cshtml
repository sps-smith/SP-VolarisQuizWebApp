    div.innerHTML = `<input type="checkbox" class="opt-correct"><input class="fi" type="text" placeholder="Option ${String.fromCharCode(65 + i)}" style="flex:1"><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#aaa;cursor:pointer;font-size:16px">x</button>`;
