                <button type="button" class="modal-close-btn" onclick="closeModal()" aria-label="Close dialog">×</button>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(130px,1fr));gap:10px;margin-bottom:14px">
                <div style="background:#fafafa;border:1px solid #eee;border-radius:8px;padding:10px">
                    <div style="font-size:11px;color:#888">Effective organizations</div>
                    <div style="font-size:20px;font-weight:800">${orgs.length}</div>
                </div>
                <div style="background:#fafafa;border:1px solid #eee;border-radius:8px;padding:10px">
                    <div style="font-size:11px;color:#888">Assigned users</div>
                    <div id="group-assigned-user-count" style="font-size:20px;font-weight:800">${Number(group.assignedUserCount ?? 0)}</div>
                </div>
                <div style="background:#fafafa;border:1px solid #eee;border-radius:8px;padding:10px">
                    <div style="font-size:11px;color:#888">Parent portfolio</div>
                    <div style="font-size:13px;font-weight:700">${escHtml(group.parentPortfolioName ?? group.portfolioId ?? '-')}</div>
                </div>
            </div>
            <div style="font-weight:700;margin-bottom:8px">Assigned users</div>
            <div style="border:1px solid #eee;border-radius:8px;padding:12px;margin-bottom:14px">
                <div class="access-picker-row" style="margin-bottom:10px">
                    <div class="access-picker-input-wrap">
                        <input class="fi" id="group-user-search" type="text" placeholder="Search users by name or email..."
                               style="width:100%" oninput="searchGroupUserCandidates('${escAttr(group.accessGroupId)}')">
                        <div id="group-user-results" class="access-results"></div>
                    </div>
                    <button type="button" class="rbtn access-add-btn" onclick="addHighlightedGroupUser('${escAttr(group.accessGroupId)}')">+ Add</button>
                </div>
                <div id="group-users-list" style="min-height:44px;color:#888;font-size:13px">Loading assigned users...</div>
            </div>
            <div style="font-weight:700;margin-bottom:8px">Effective organization preview</div>
            <div style="border:1px solid #eee;border-radius:8px;max-height:280px;overflow:auto">
                ${orgs.length ? `
                    <table class="dt" style="margin:0">
                        <thead><tr><th>Organization</th><th>ID</th><th>Reports to</th></tr></thead>
                        <tbody>
                        ${orgs.slice(0, 75).map(org => `
                            <tr>
                                <td>${escHtml(org.organizationName)}</td>
                                <td>${Number(org.organizationId)}</td>
                                <td>${escHtml(org.reportToName || '-')}</td>
                            </tr>`).join('')}
                        </tbody>
                    </table>
                    ${orgs.length > 75 ? `<div style="padding:10px;font-size:12px;color:#888">Showing first 75 of ${orgs.length} organizations.</div>` : ''}
                ` : '<div style="padding:14px;color:#888">No effective organizations were found for this group.</div>'}
            </div>
            <div class="access-edit-footer">
                <button class="bex" onclick="closeModal()">Close</button>
                <button class="bec" onclick="setGroupStatus('${escAttr(group.accessGroupId)}', ${!group.isActive})">${group.isActive ? 'Deactivate group' : 'Activate group'}</button>
            </div>
        </div>`);
    loadGroupUsers(accessGroupId);
}

async function loadGroupUsers(accessGroupId) {
    const list = document.getElementById('group-users-list');
    if (list) list.innerHTML = '<div style="padding:10px;color:#888">Loading assigned users...</div>';

    const resp = await fetch(`/admin/groups/${accessGroupId}/users`, { headers: { Accept: 'application/json' } });
    if (!resp.ok) {
        if (list) list.innerHTML = `<div style="padding:10px;color:#A32D2D">${escHtml(await responseErrorMessage(resp, 'Failed to load assigned users.'))}</div>`;
        return;
    }

    const users = await resp.json();
    window._groupUserState = window._groupUserState ?? { accessGroupId, users: [], candidates: [] };
    window._groupUserState.users = users ?? [];
    renderGroupUsers(accessGroupId, window._groupUserState.users);
}

function renderGroupUsers(accessGroupId, users) {
    const list = document.getElementById('group-users-list');
    const count = document.getElementById('group-assigned-user-count');
    if (count) count.textContent = String(users.length);
    if (!list) return;

    if (!users.length) {
        list.innerHTML = '<div style="padding:10px;color:#888">No users are assigned to this group yet.</div>';
        return;
    }

    list.innerHTML = `
        <div style="display:grid;gap:8px">
            ${users.map(user => `
                <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid #eee;border-radius:8px;padding:9px 10px;background:#fff">
                    <div>
                        <div style="font-weight:700;color:#333">${escHtml(user.fullName || 'Unknown user')}</div>
                        <div style="font-size:12px;color:#888">${escHtml(user.email || '')} - ${escHtml(user.roleName || user.roleCode || '')}</div>
                    </div>
                    <button class="rbtn danger" onclick="removeGroupUser('${escAttr(accessGroupId)}', '${escAttr(user.userId)}')">Remove</button>
                </div>`).join('')}
        </div>`;
}

function searchGroupUserCandidates(accessGroupId) {
    const input = document.getElementById('group-user-search');
    const results = document.getElementById('group-user-results');
    const term = input?.value.trim() ?? '';
    clearTimeout(window._groupUserLookupTimer);
    if (!term) {
        if (results) results.style.display = 'none';
        return;
    }

    window._groupUserLookupTimer = setTimeout(async () => {
        const resp = await fetch(`/admin/groups/user-candidates?term=${encodeURIComponent(term)}`, { headers: { Accept: 'application/json' } });
        if (!resp.ok || !results) return;

        const assignedIds = new Set((window._groupUserState?.users ?? []).map(user => String(user.userId).toLowerCase()));
        const candidates = (await resp.json())
            .filter(user => !assignedIds.has(String(user.userId).toLowerCase()));

        window._groupUserState = window._groupUserState ?? { accessGroupId, users: [], candidates: [] };
        window._groupUserState.candidates = candidates;
        results.innerHTML = candidates.length
            ? candidates.map(user => `
                <button type="button" class="access-result" data-user-id="${escAttr(user.userId)}" onclick="addGroupUserFromButton('${escAttr(accessGroupId)}', this)"
                        style="display:block;width:100%;text-align:left;padding:9px 10px;border:0;background:#fff;cursor:pointer;font-size:13px">
                    <strong>${escHtml(user.fullName || 'Unknown user')}</strong>
                    <span style="color:#888"> ${escHtml(user.email || '')}</span>
                </button>`).join('')
            : '<div style="padding:10px;font-size:13px;color:#888">No matching users</div>';
        results.style.display = 'block';
    }, 250);
}

function addHighlightedGroupUser(accessGroupId) {
    const candidates = window._groupUserState?.candidates ?? [];
    if (!candidates.length) return;
    addGroupUser(accessGroupId, candidates[0].userId);
}

function addGroupUserFromButton(accessGroupId, button) {
    addGroupUser(accessGroupId, button.dataset.userId);
}

async function addGroupUser(accessGroupId, userId) {
    if (!userId) return;
    const resp = await fetch(`/admin/groups/${accessGroupId}/users/${userId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }
    });
    if (!resp.ok) {
        alert(await responseErrorMessage(resp, 'Failed to add user to group.'));
        return;
    }

    const users = await resp.json();
    const results = document.getElementById('group-user-results');
    const search = document.getElementById('group-user-search');
    if (results) results.style.display = 'none';
    if (search) search.value = '';
    window._groupUserState.users = users ?? [];
    window._groupUserState.candidates = [];
    renderGroupUsers(accessGroupId, window._groupUserState.users);
}

async function removeGroupUser(accessGroupId, userId) {
    if (!confirm('Remove this user from the group?')) return;
    const resp = await fetch(`/admin/groups/${accessGroupId}/users/${userId}`, {
        method: 'DELETE',
        headers: { 'RequestVerificationToken': TOKEN }
    });
    if (!resp.ok) {
        alert(await responseErrorMessage(resp, 'Failed to remove user from group.'));
        return;
    }

    const users = await resp.json();
    window._groupUserState.users = users ?? [];
    renderGroupUsers(accessGroupId, window._groupUserState.users);
}

async function setGroupStatus(accessGroupId, isActive) {
    const action = isActive ? 'activate' : 'deactivate';
    if (!confirm(`Are you sure you want to ${action} this group?`)) return;
    const resp = await fetch(`/admin/groups/${accessGroupId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify({ isActive })
    });
    if (resp.ok) location.reload();
    else alert(await responseErrorMessage(resp, 'Failed to update group status.'));
}

async function reseedGroups() {
    if (!confirm('Reseed system-managed portfolio groups and sub-groups from the current portfolio and VBU master data?')) return;
    const resp = await fetch('/admin/groups/reseed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }
    });
    if (!resp.ok) {
        alert(await responseErrorMessage(resp, 'Failed to reseed groups.'));
        return;
    }

    const result = await resp.json();
    alert(`Created ${result.portfolioGroupsCreated ?? 0} portfolio groups and ${result.portfolioSubGroupsCreated ?? 0} portfolio sub-groups.`);
    location.reload();
}

function searchGroups() {
    const q = document.getElementById('groups-search')?.value ?? '';
    const organizationSearch = document.getElementById('groups-org-search')?.value ?? '';
    const type = document.getElementById('groups-type')?.value ?? '';
    const includeInactive = document.getElementById('groups-include-inactive')?.checked ?? true;
    clearTimeout(window._grpTimer);
    window._grpTimer = setTimeout(() => {
        setAdminFilterLoading(true);
        const params = new URLSearchParams();
        if (q) params.set('search', q);
        if (organizationSearch) params.set('organizationSearch', organizationSearch);
        if (type) params.set('type', type);
        params.set('includeInactive', includeInactive ? 'true' : 'false');
        window.location.href = `/admin/groups?${params}`;
    }, 400);
}

function toggleGroupsSearchClear() {
    const search = document.getElementById('groups-search');
    const clear = document.getElementById('groups-search-clear');
    if (!search || !clear) return;
    clear.hidden = !search.value;
}

function clearGroupsSearch() {
    const search = document.getElementById('groups-search');
    if (!search) return;
    search.value = '';
    toggleGroupsSearchClear();
    searchGroups();
    search.focus();
}

function toggleGroupsOrgSearchClear() {
    const search = document.getElementById('groups-org-search');
    const clear = document.getElementById('groups-org-search-clear');
    if (!search || !clear) return;
    clear.hidden = !search.value;
}

function clearGroupsOrgSearch() {
    const search = document.getElementById('groups-org-search');
    if (!search) return;
    search.value = '';
    toggleGroupsOrgSearchClear();
    searchGroups();
    search.focus();
}

function searchUsers() {
    const q = document.getElementById('users-search')?.value ?? '';
    clearTimeout(window._usrTimer);
    window._usrTimer = setTimeout(() => {
        setAdminFilterLoading(true);
        window.location.href = `/admin/users?search=${encodeURIComponent(q)}`;
    }, 400);
}

function toggleUsersSearchClear() {
    const search = document.getElementById('users-search');
    const clear = document.getElementById('users-search-clear');
    if (!search || !clear) return;
    clear.hidden = !search.value;
}

function clearUsersSearch() {
    const search = document.getElementById('users-search');
    if (!search) return;
    search.value = '';
    toggleUsersSearchClear();
    searchUsers();
    search.focus();
}

function searchQuestions() {
    const search = document.getElementById('q-search')?.value ?? '';
    const quizId = document.getElementById('q-quiz-filter')?.value ?? '';
    const lang = document.getElementById('q-lang')?.value ?? '';
    clearTimeout(window._qTimer);
    window._qTimer = setTimeout(() => {
        setAdminFilterLoading(true);
        const params = new URLSearchParams();
        if (lang) params.set('lang', lang);
        if (search) params.set('search', search);
        if (quizId) params.set('quizId', quizId);
        window.location.href = `/admin/cms/questions?${params}`;
    }, 400);
}

function setAdminFilterLoading(isLoading, text = 'Updating results...') {
    const loader = document.getElementById('admin-filter-loading');
    const textEl = document.querySelector('#admin-filter-loading .filter-loading-text');
    if (loader) loader.hidden = !isLoading;
    if (textEl) textEl.textContent = text;
}

function escHtml(s) {
    return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function escAttr(s) {
    return escHtml(s);
}

async function responseErrorMessage(resp, fallback) {
    const text = await resp.text();
    if (!text) return `${fallback} (HTTP ${resp.status}${resp.statusText ? ` ${resp.statusText}` : ''})`;

    try {
        const json = JSON.parse(text);
        if (json.error) return json.error;
        const messages = Object.values(json)
            .flatMap(value => Array.isArray(value) ? value : [value])
            .filter(Boolean);
        return messages.length ? messages.join('\n') : fallback;
    } catch {
        return text;
    }
}

toggleUsersSearchClear();
toggleGroupsSearchClear();
toggleGroupsOrgSearchClear();
resetImpersonationSelection();
updateImpersonationButtonState();
</script>
