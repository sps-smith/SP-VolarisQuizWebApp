function getMergeState() {
    if (!window._mergeUsersState) {
        window._mergeUsersState = {
            sourceUsers: [],
            targetUser: null,
            sourceResults: [],
            targetResults: [],
            sourceSearchTerm: '',
            targetSearchTerm: '',
            preview: null,
            isSearchingSources: false,
            isSearchingTarget: false,
            isPreviewLoading: false,
            isExecuteLoading: false
        };
    }
    return window._mergeUsersState;
}

function renderBulkMergeModal() {
    const state = getMergeState();
    const sourceSearch = document.getElementById('merge-source-search');
    const targetSearch = document.getElementById('merge-target-search');
    if (sourceSearch && sourceSearch.value !== state.sourceSearchTerm) sourceSearch.value = state.sourceSearchTerm;
    if (targetSearch && targetSearch.value !== state.targetSearchTerm) targetSearch.value = state.targetSearchTerm;

    const sourceSelected = document.getElementById('merge-source-selected');
    const sourceResults = document.getElementById('merge-source-results');
    const targetSelected = document.getElementById('merge-target-selected');
    const targetResults = document.getElementById('merge-target-results');
    const previewPanel = document.getElementById('merge-preview-panel');
    const previewBtn = document.getElementById('merge-preview-btn');
    const executeBtn = document.getElementById('merge-execute-btn');

    if (sourceSelected) {
        sourceSelected.innerHTML = state.sourceUsers.length
            ? `<div style="display:flex;flex-wrap:wrap;gap:8px">${state.sourceUsers.map(user => mergeUserChip(user, true)).join('')}</div>`
            : '<div style="font-size:13px;color:#888">No source users selected yet.</div>';
    }

    if (targetSelected) {
        targetSelected.innerHTML = state.targetUser
            ? mergeUserCard(state.targetUser, { actionText: 'Clear target', action: 'clearTargetUser()' })
            : '<div style="font-size:13px;color:#888">No target user selected yet.</div>';
    }

    if (sourceResults) {
        sourceResults.innerHTML = renderMergeResults(
            state.isSearchingSources,
            state.sourceResults,
            'Add source',
            'addSourceUser',
            state.sourceUsers.map(user => user.userId),
            state.targetUser ? [state.targetUser.userId] : []);
    }

    if (targetResults) {
        targetResults.innerHTML = renderMergeResults(
            state.isSearchingTarget,
            state.targetResults,
            'Choose target',
            'setTargetUser',
            state.targetUser ? [state.targetUser.userId] : [],
            state.sourceUsers.map(user => user.userId));
    }

    if (previewPanel) {
        previewPanel.innerHTML = renderMergePreview(state);
    }

    if (previewBtn) {
        previewBtn.disabled = state.isPreviewLoading || state.sourceUsers.length === 0 || !state.targetUser;
        previewBtn.textContent = state.isPreviewLoading ? 'Loading preview...' : 'Preview merge';
    }

    if (executeBtn) {
        executeBtn.disabled = state.isExecuteLoading || !state.preview?.canMerge;
        executeBtn.textContent = state.isExecuteLoading ? 'Merging...' : 'Merge selected users';
    }
}

function renderMergeResults(isLoading, results, actionText, actionName, selectedIds, excludedIds) {
    if (isLoading) {
        return '<div style="font-size:13px;color:#888">Searching users...</div>';
    }

    const blocked = new Set([...(selectedIds ?? []), ...(excludedIds ?? [])]);
    const visible = (results ?? []).filter(user => !blocked.has(user.userId));
    if (!visible.length) {
        return '<div style="font-size:13px;color:#888">No matching users.</div>';
    }

    return visible.map(user => mergeUserCard(user, {
        actionText,
        action: `${actionName}('${user.userId}')`
    })).join('');
}

function renderMergePreview(state) {
    if (state.isPreviewLoading) {
        return '<div style="font-size:13px;color:#888">Loading preview...</div>';
    }

    if (!state.preview) {
        return '<div style="font-size:13px;color:#888">Select source and target users, then preview the merge.</div>';
    }

    const preview = state.preview;
    const stats = preview.statistics ?? {};
    const warnings = preview.warnings ?? [];
    const warningHtml = warnings.length
        ? `<div style="display:grid;gap:8px;margin-bottom:14px">${warnings.map(warning => `<div style="padding:10px 12px;border-radius:10px;background:#fff4f4;border:1px solid #f1d6d6;color:#8b2a2a;font-size:13px">${escHtml(warning)}</div>`).join('')}</div>`
        : '<div style="padding:10px 12px;border-radius:10px;background:#f3fbf5;border:1px solid #d7eadc;color:#1f6a33;font-size:13px;margin-bottom:14px">No blocking issues were found for this merge.</div>';

    return `
        ${warningHtml}
        <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px">
            ${mergeStatCard('Source users', String(preview.sources?.length ?? 0))}
            ${mergeStatCard('Quiz attempts to move', String(stats.quizAttemptsToMove ?? 0))}
            ${mergeStatCard('Source completions', String(stats.sourceCompletionRecordCount ?? 0))}
            ${mergeStatCard('Target completion', stats.targetWillBeComplete ? 'Complete' : (stats.targetHasCompletionRecord ? 'Already complete' : 'Not complete'))}
        </div>
        <div style="font-size:12px;color:#777;margin-top:14px">${preview.canMerge ? 'This merge is ready to run.' : 'Resolve the warnings above before running the merge.'}</div>`;
}

