async function openEditRoleModal(userId, currentRole, fullName, email, company, portfolio) {
    const [accessResp, groupAssignmentsResp, groupOptionsResp] = await Promise.all([
        fetch(`/admin/users/${userId}/access`, { headers: { Accept: 'application/json' } }),
        fetch(`/admin/users/${userId}/groups`, { headers: { Accept: 'application/json' } }),
        fetch('/admin/groups?includeInactive=false', { headers: { Accept: 'application/json' } })
    ]);
    if (!accessResp.ok || !groupAssignmentsResp.ok || !groupOptionsResp.ok) {
        alert(await responseErrorMessage(accessResp.ok ? (groupAssignmentsResp.ok ? groupOptionsResp : groupAssignmentsResp) : accessResp, 'Failed to load user access.'));
        return;
    }
    const access = await accessResp.json();
    const assignedGroups = await groupAssignmentsResp.json();
    window._accessGroupOptions = await groupOptionsResp.json();
    window._accessEditor = {
        userId,
        orgs: [...(access.assignedOrganizations ?? [])],
        portfolios: [...(access.assignedPortfolios ?? [])],
        groups: [...(assignedGroups ?? [])]
    };

    const roles = [
        ['Learner', 'Access to own dashboard and quizzes only.'],
        ['ReportingAdmin', 'Reporting access scoped by assigned access groups.'],
        ['GlobalAdmin', 'Full platform access. Manages roles, course content, and user access.']
    ];
    const selectedRole = normalizeRoleForEditor(access.roleCode || currentRole);
    openModal(`
        <div class="access-edit-modal">
            <div class="access-edit-header">
                <div>
                    <h3 class="access-edit-title">Edit role</h3>
                    <div class="access-edit-subtitle">Roles are managed in this platform only. Changes take effect immediately and persist across sign-ins.</div>
                    <div class="access-edit-note" style="margin-top:6px;font-size:12px;color:#7a5a00">
                        Reporting Admin access is controlled by assigned groups. Saving a legacy Org Admin or Portfolio Admin as Reporting Admin moves the user to the combined role.
                    </div>
                </div>
                <button type="button" class="modal-close-btn" onclick="closeModal()" aria-label="Close dialog">×</button>
            </div>
            <div class="access-user-card">
                <div class="access-user-avatar">${userInitials(fullName)}</div>
                <div class="access-user-meta">
                    <div class="access-user-name">${escHtml(fullName || 'Unknown User')}</div>
                    <div class="access-user-line">${escHtml(email || '')}${email && company ? ' · ' : ''}${escHtml(company || '')}${(email || company) && portfolio ? ' · ' : ''}${escHtml(portfolio || '')}</div>
                </div>
            </div>
            <div class="access-section-label">Assign role</div>
            <div class="access-role-list">
            ${roles.map(([r, d]) => `
                <label class="role-choice ${r === selectedRole ? 'is-selected' : ''}">
                    <input type="radio" name="new-role" value="${r}" ${r === selectedRole ? 'checked' : ''} onchange="renderAccessScopePanel()">
                    <div class="role-choice-copy">
                        <div class="role-choice-title">${roleLabel(r)}</div>
                        <div class="role-choice-desc">${d}</div>
                    </div>
                </label>`).join('')}
            </div>
            <div id="access-scope-panel" class="access-scope-panel"></div>
            <div class="access-edit-footer">
                <button class="bex" onclick="closeModal()">Cancel</button>
                <button class="bec" onclick="saveRole('${userId}')">Save role</button>
            </div>
        </div>`);
    renderAccessScopePanel();
}

async function saveRole(userId) {
    const selected = document.querySelector('input[name="new-role"]:checked');
    if (!selected) return;
    const state = window._accessEditor ?? { orgs: [], portfolios: [], groups: [] };
    const orgIds = selected.value === 'OrgAdmin' ? (state.orgs ?? []) : [];
    const portfolioIds = selected.value === 'PortfolioAdmin' ? (state.portfolios ?? []) : [];
    const groupIds = selected.value === 'ReportingAdmin' ? (state.groups ?? []) : [];
    const body = {
        roleCode: selected.value,
        organizationIds: orgIds.map(o => o.id),
        portfolioIds: portfolioIds.map(p => p.id)
    };
    const resp = await fetch(`/admin/users/${userId}/access`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify(body)
    });
    if (!resp.ok) {
        const e = await resp.json();
        alert(e.error || 'Failed to update role.');
        return;
    }

    const groupResp = await fetch(`/admin/users/${userId}/groups`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify({ accessGroupIds: groupIds.map(g => g.accessGroupId) })
    });
    if (groupResp.ok) { closeModal(); location.reload(); }
    else { alert(await responseErrorMessage(groupResp, 'Role was saved, but group assignments could not be updated.')); }
}

function renderAccessScopePanel() {
    const selected = document.querySelector('input[name="new-role"]:checked')?.value ?? 'Learner';
    const state = window._accessEditor ?? { orgs: [], portfolios: [] };
    document.querySelectorAll('.role-choice').forEach(label => {
        const input = label.querySelector('input[name="new-role"]');
        label.classList.toggle('is-selected', !!input?.checked);
    });

    const panel = document.getElementById('access-scope-panel');
    if (!panel) return;

    if (selected === 'OrgAdmin') {
        state.portfolios = [];
        window._accessEditor = state;
        panel.innerHTML = accessPickerHtml(
            'VBU access',
            'Type a VBU name or ID...',
            'org',
            state.orgs ?? []
        );
        return;
    }

    if (selected === 'ReportingAdmin') {
        state.orgs = [];
        state.portfolios = [];
        window._accessEditor = state;
        panel.innerHTML = accessGroupPickerHtml(state.groups ?? []);
        return;
    }

    state.orgs = [];
    state.portfolios = [];
    state.groups = [];
    window._accessEditor = state;
    panel.innerHTML = '';
}

