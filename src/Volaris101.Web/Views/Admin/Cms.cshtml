function searchMergeCandidates(kind) {
    const state = getMergeState();
    const input = document.getElementById(kind === 'source' ? 'merge-source-search' : 'merge-target-search');
    const term = input?.value ?? '';
    const normalizedTerm = term.trim();

    if (kind === 'source') {
        state.sourceSearchTerm = term;
        state.preview = null;
    } else {
        state.targetSearchTerm = term;
        state.preview = null;
    }

    const timerKey = kind === 'source' ? '_mergeSourceTimer' : '_mergeTargetTimer';
    clearTimeout(window[timerKey]);

    if (!normalizedTerm) {
        if (kind === 'source') state.sourceResults = [];
        else state.targetResults = [];
        renderBulkMergeModal();
        return;
    }

    if (kind === 'source') state.isSearchingSources = true;
    else state.isSearchingTarget = true;
    renderBulkMergeModal();

    window[timerKey] = setTimeout(async () => {
        const resp = await fetch(`/admin/users/merge/candidates?term=${encodeURIComponent(term)}`, {
            headers: { Accept: 'application/json' }
        });

        if (!resp.ok) {
            alert(await responseErrorMessage(resp, 'Failed to search users.'));
            if (kind === 'source') state.isSearchingSources = false;
            else state.isSearchingTarget = false;
            renderBulkMergeModal();
            return;
        }

        const results = await resp.json();
        if (kind === 'source') {
            state.sourceResults = results;
            state.isSearchingSources = false;
        } else {
            state.targetResults = results;
            state.isSearchingTarget = false;
        }
        renderBulkMergeModal();
    }, 250);
}

function addSourceUser(userId) {
    const state = getMergeState();
    const user = (state.sourceResults ?? []).find(candidate => candidate.userId === userId);
    if (!user || (state.sourceUsers ?? []).some(candidate => candidate.userId === userId))
        return;

    state.sourceUsers.push(user);
    state.preview = null;
    renderBulkMergeModal();
}

function removeSourceUser(userId) {
    const state = getMergeState();
    state.sourceUsers = (state.sourceUsers ?? []).filter(user => user.userId !== userId);
    state.preview = null;
    renderBulkMergeModal();
}

function setTargetUser(userId) {
    const state = getMergeState();
    const user = (state.targetResults ?? []).find(candidate => candidate.userId === userId);
    if (!user)
        return;

    state.targetUser = user;
    state.preview = null;
    renderBulkMergeModal();
}

function clearTargetUser() {
    const state = getMergeState();
    state.targetUser = null;
    state.preview = null;
    renderBulkMergeModal();
}

async function previewBulkMerge() {
    const state = getMergeState();
    if (!state.sourceUsers.length || !state.targetUser) {
        alert('Select at least one source user and one target user.');
        return;
    }

    state.isPreviewLoading = true;
    state.preview = null;
    renderBulkMergeModal();

    const body = {
        sourceUserIds: state.sourceUsers.map(user => user.userId),
        targetUserId: state.targetUser.userId
    };

    const resp = await fetch('/admin/users/merge/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify(body)
    });

    state.isPreviewLoading = false;
    if (!resp.ok) {
        renderBulkMergeModal();
        alert(await responseErrorMessage(resp, 'Failed to preview merge.'));
        return;
    }

    state.preview = await resp.json();
    renderBulkMergeModal();
}

async function executeBulkMerge() {
    const state = getMergeState();
    if (!state.preview?.canMerge || !state.targetUser || !state.sourceUsers.length) {
        alert('Preview a valid merge before continuing.');
        return;
    }

    const sourceNames = state.sourceUsers.map(user => user.fullName).join(', ');
    if (!confirm(`Merge quiz history from ${sourceNames} into ${state.targetUser.fullName}?\n\nThis will deactivate the source users.`))
        return;

    state.isExecuteLoading = true;
    renderBulkMergeModal();

    const body = {
        sourceUserIds: state.sourceUsers.map(user => user.userId),
        targetUserId: state.targetUser.userId
    };

    const resp = await fetch('/admin/users/merge/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify(body)
    });

    state.isExecuteLoading = false;
    if (!resp.ok) {
        renderBulkMergeModal();
        alert(await responseErrorMessage(resp, 'Failed to merge users.'));
        return;
    }

    const result = await resp.json();
    alert(`Merge complete. ${result.quizAttemptsMoved} quiz attempts moved from ${result.sourceUserCount} source user(s).`);
    closeModal();
    location.reload();
}

