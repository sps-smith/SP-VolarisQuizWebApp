                <button type="button" class="modal-close-btn" onclick="closeModal()" aria-label="Close dialog">x</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start">
                <section style="border:1px solid #eceae4;border-radius:12px;padding:16px;background:#fffaf7">
