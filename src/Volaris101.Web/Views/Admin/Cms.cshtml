                    <input class="fi" id="merge-target-search" type="text" placeholder="Search name or email..." style="width:100%" oninput="searchMergeCandidates('target')">
                    <div id="merge-target-selected" style="margin-top:12px"></div>
                    <div id="merge-target-results" style="margin-top:12px;max-height:260px;overflow:auto;border-top:1px solid #f0ede7;padding-top:12px"></div>
