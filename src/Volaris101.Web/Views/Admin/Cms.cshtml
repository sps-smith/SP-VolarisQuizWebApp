@model Volaris101.Web.Controllers.CmsPageModel
@inject Volaris101.Application.Interfaces.ICurrentUserContext UserCtx
@{
    ViewData["Title"] = "Admin";
    ViewData["ActiveTab"] = "admin";
}

<div class="atabs">
    <a class="atab @(Model.ActiveTab == "byquiz" ? "on" : "")" href="/admin/cms">By quiz</a>
    <a class="atab @(Model.ActiveTab == "allq" ? "on" : "")" href="/admin/cms/questions">All questions</a>
    <a class="atab @(Model.ActiveTab == "roles" ? "on" : "")" href="/admin/users">Roles &amp; users</a>
    <a class="atab @(Model.ActiveTab == "groups" ? "on" : "")" href="/admin/groups">Groups</a>
</div>

<div hidden>
    @Html.AntiForgeryToken()
</div>

@if (Model.ActiveTab == "byquiz")
{
    <div class="admin-toolbar">
        <div class="admin-helper">Select a quiz to view and edit its questions</div>
        <button class="bec" onclick="openAddQuizModal()">+ Add quiz</button>
    </div>

    <div class="admin-quiz-list">
        @foreach (var quiz in Model.Quizzes)
        {
            var selectedQuiz = Model.SelectedQuiz?.QuizId == quiz.QuizId ? Model.SelectedQuiz : null;
            <section class="admin-quiz-card @(selectedQuiz != null ? "is-open" : "")">
                <div class="admin-quiz-head">
                    <div>
                        <div class="admin-quiz-eyebrow">MODULE @quiz.DisplayOrder</div>
                        <h2>M@(quiz.DisplayOrder): @quiz.Title</h2>
                    </div>
                    <div class="admin-quiz-meta">
                        <span class="tag @(quiz.IsPublished ? "tc" : "draft")">@(quiz.IsPublished ? "Published" : "Draft")</span>
                        <span>@quiz.QuestionCount question@(quiz.QuestionCount != 1 ? "s" : "")</span>
                        @if (!quiz.IsPublished)
                        {
                            <button class="bec" data-quiz-id="@quiz.QuizId" data-quiz-title="@quiz.Title" onclick="publishQuizFromButton(this)">Publish</button>
                        }
                        <button class="rbtn" data-quiz-id="@quiz.QuizId" data-quiz-title="@quiz.Title" data-quiz-published="@quiz.IsPublished.ToString().ToLowerInvariant()" onclick="openCopyQuizLinkModalFromButton(this)">Copy quiz link</button>
                        @if (selectedQuiz != null)
                        {
                            <button class="rbtn" data-quiz-id="@quiz.QuizId" data-quiz-title="@quiz.Title" onclick="openEditQuizModalFromButton(this)">Edit quiz</button>
                            <button class="bec" onclick="openAddQuestionModal('@quiz.QuizId')">+ Add question</button>
                        }
                        else
                        {
                            <a class="rbtn" href="/admin/cms/quiz/@quiz.QuizId">View questions</a>
                        }
                    </div>
                </div>

                @if (selectedQuiz != null)
                {
                    <div class="admin-lang-row">
                        @foreach (var language in selectedQuiz.Languages)
                        {
                            <a class="admin-lang-chip @(language.IsSelected ? "on" : "")"
                               href="/admin/cms/quiz/@quiz.QuizId?lang=@language.Code"
                               aria-current="@(language.IsSelected ? "true" : "false")">
                                @language.Label
                            </a>
                        }
                    </div>

                    <div class="admin-qtable-wrap" id="quiz-questions-@quiz.QuizId">
                        <table class="dt admin-qtable">
                            <thead>
                                <tr>
                                    <th>Question</th>
                                    <th>Type</th>
                                    <th>Correct answer(s)</th>
                                    <th class="admin-qactions"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in selectedQuiz.Questions)
                                {
                                    var correctAnswers = q.Options
                                        .Where(o => o.IsCorrect)
                                        .OrderBy(o => o.DisplayOrder)
                                        .Select(o => $"{(char)('A' + Math.Max(o.DisplayOrder, 1) - 1)}: {o.OptionText}")
                                        .ToList();
                                    var correctAnswerText = correctAnswers.Count > 0
                                        ? string.Join("; ", correctAnswers)
                                        : "No correct answer set";

                                    <tr>
                                        <td class="admin-question-cell">@q.QuestionText</td>
                                        <td><span class="tag @(q.IsMultiSelect ? "te" : "tn2")">@(q.IsMultiSelect ? "Multi" : "Single")</span></td>
                                        <td class="admin-answer-cell">@correctAnswerText</td>
                                        <td class="admin-qactions">
                                            <button class="rbtn" onclick="openEditQuestion('@q.QuestionId', '@selectedQuiz.SelectedLanguage')">Edit</button>
                                            <button class="rbtn danger" onclick="deleteQuestion('@q.QuestionId')">Del</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
}

@if (Model.ActiveTab == "allq")
{
    var allqSearch = Context.Request.Query["search"].ToString();
    var allqQuizId = Context.Request.Query["quizId"].ToString();
    var allqLanguages = new[] { ("en", "EN"), ("de", "DE"), ("es", "ES"), ("fr", "FR"), ("pt", "PT") };
    string AllQuestionLangUrl(string code)
    {
        var parts = new List<string> { $"lang={code}" };
        if (!string.IsNullOrWhiteSpace(allqSearch))
            parts.Add($"search={System.Net.WebUtility.UrlEncode(allqSearch)}");
        if (!string.IsNullOrWhiteSpace(allqQuizId))
            parts.Add($"quizId={System.Net.WebUtility.UrlEncode(allqQuizId)}");
        return "/admin/cms/questions?" + string.Join("&", parts);
    }

    <div class="allq-toolbar">
        <div class="allq-filters">
            <input class="fi allq-search" id="q-search" type="text" placeholder="Search questions..."
                   value="@allqSearch" oninput="searchQuestions()">
            <select class="fi allq-quiz-filter" id="q-quiz-filter" onchange="searchQuestions()">
                <option value="">All quizzes</option>
                @foreach (var q in Model.Quizzes)
                {
                    <option value="@q.QuizId" selected="@(q.QuizId.ToString().Equals(allqQuizId, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">M@(q.DisplayOrder): @q.Title</option>
                }
            </select>
            <input type="hidden" id="q-lang" value="@Model.SelectedLanguage">
        </div>

        <div class="allq-language">
            <span>View language:</span>
            @foreach (var (code, label) in allqLanguages)
            {
                <a class="admin-lang-chip @(Model.SelectedLanguage == code ? "on" : "")"
                   href="@AllQuestionLangUrl(code)"
                   aria-current="@(Model.SelectedLanguage == code ? "true" : "false")">@label</a>
            }
        </div>

        <span id="q-count" class="allq-count">@(Model.AllQuestions?.Count ?? 0) questions</span>
    </div>
    <div class="filter-loading" id="admin-filter-loading" hidden style="padding-top:0;margin-bottom:12px">
        <div class="filter-spinner"></div>
        <span class="filter-loading-text">Updating results...</span>
    </div>

    <div class="allq-table-panel">
        <table class="dt allq-table">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Quiz</th>
                    <th>Type</th>
                    <th>Options</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="allq-tbody">
                @if (Model.AllQuestions != null)
                {
                    @foreach (var q in Model.AllQuestions)
                    {
                        <tr>
                            <td class="allq-question">@q.QuestionText</td>
                            <td class="allq-quiz">
                                @if (q.QuizDisplayOrder.HasValue && !string.IsNullOrWhiteSpace(q.QuizTitle))
                                {
                                    @:M@(q.QuizDisplayOrder): @q.QuizTitle
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                            <td><span class="tag @(q.IsMultiSelect ? "te" : "tn2")">@(q.IsMultiSelect ? "Multi" : "Single")</span></td>
                            <td class="allq-options">@q.Options.Count option@(q.Options.Count != 1 ? "s" : "")</td>
                            <td class="allq-actions">
                                <button class="rbtn" onclick="openEditQuestion('@q.QuestionId', '@Model.SelectedLanguage')">Edit</button>
                                <button class="rbtn danger" onclick="deleteQuestion('@q.QuestionId')">Del</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (Model.ActiveTab == "roles")
{
    var usersSearch = Context.Request.Query["search"].ToString();
    <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap">
        @{
            var roleCards = new[] {
                ("Learner", "#888", "Access to own dashboard and quizzes only."),
                ("ReportingAdmin", "#185FA5", "Reporting access scoped by assigned access groups."),
                ("GlobalAdmin", "#C41230", "Full platform access. Manages roles, course content, and user access.")
            };
        }
        @foreach (var (role, color, desc) in roleCards)
        {
            <div style="background:#fff;border:1px solid #e8e8e6;border-radius:8px;padding:10px 14px;font-size:12px;color:#555;flex:1;min-width:180px">
                <div style="font-weight:700;color:@color;margin-bottom:3px">@role</div>
                @desc
            </div>
        }
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <div style="display:flex;gap:10px">
            <div class="clearable-input" style="width:240px">
                <input class="fi" id="users-search" type="text" placeholder="Name or email..."
                       value="@usersSearch"
                       oninput="toggleUsersSearchClear(); searchUsers()">
                <button class="clear-input-btn" id="users-search-clear" type="button"
                        onclick="clearUsersSearch()"
                        aria-label="Clear user search"
                        title="Clear user search">x</button>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <span id="roles-count" style="font-size:13px;color:#aaa">@(Model.Users?.Count ?? 0) of @Model.UserTotalCount users</span>
            <button class="bec" onclick="openBulkMergeModal()">Merge quiz data</button>
            <button class="bec" id="impersonate-selected-btn" onclick="impersonateSelectedUser()" disabled>Impersonate</button>
            <button class="bec" onclick="openAddUserModal()">+ Add user</button>
        </div>
    </div>
    <div class="filter-loading" id="admin-filter-loading" hidden style="padding-top:0;margin-bottom:12px">
        <div class="filter-spinner"></div>
        <span class="filter-loading-text">Updating results...</span>
    </div>

    <div class="panel" style="padding:0">
        <table class="dt">
            <thead>
                <tr>
                    <th style="width:34px"></th>
                    <th>Name</th><th>Email</th><th>Organization</th><th>Portfolio</th><th>Scoped organizations/portfolios</th>
                    <th>Role</th><th>Last active</th><th style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users != null)
                {
                    @foreach (var u in Model.Users)
                    {
                        <tr style="@(u.IsActive ? "" : "opacity:0.6")">
                            <td style="text-align:center">
                                <input type="radio"
                                       name="impersonate-user"
                                       class="impersonate-user-radio"
                                       value="@u.UserId"
                                       data-user-id="@u.UserId"
                                       data-user-name="@u.FullName"
                                       data-is-active="@u.IsActive.ToString().ToLowerInvariant()"
                                       data-is-self="@(UserCtx.UserId == u.UserId ? "true" : "false")"
                                       @((UserCtx.UserId == u.UserId) ? "disabled=\"disabled\"" : "")
                                       title="@(UserCtx.UserId == u.UserId ? "You cannot impersonate your own account." : "Select this user to impersonate.")"
                                       onchange="selectImpersonationUser(this)">
                            </td>
                            <td><strong>@u.FullName</strong></td>
                            <td style="font-size:12px;color:#888">@u.Email</td>
                            <td>@u.Company</td>
                            <td>@u.Portfolio</td>
                            <td>@u.ScopedCompaniesAndPortfolios</td>
                            <td><span class="tag tc">@u.RoleName</span></td>
                            <td>@(u.LastLoginAt?.ToString("d MMM yyyy") ?? "-")</td>
                            <td style="white-space:nowrap">
                                <button class="rbtn" onclick="openEditRoleModalFromButton(this)"
                                        data-user-id="@u.UserId"
                                        data-role-code="@u.RoleCode"
                                        data-full-name="@u.FullName"
                                        data-email="@u.Email"
                                        data-company="@u.Company"
                                        data-portfolio="@u.Portfolio"
                                        style="margin-right:4px">Edit</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (Model.ActiveTab == "groups")
{
    var groupSearch = Context.Request.Query["search"].ToString();
    var groupOrgSearch = Context.Request.Query["organizationSearch"].ToString();
    var groupType = Context.Request.Query["type"].ToString();
    var includeInactive = Context.Request.Query["includeInactive"].ToString();
    <div style="display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:10px;margin-bottom:16px">
        <div style="background:#fff;border:1px solid #e8e8e6;border-radius:8px;padding:12px 14px">
            <div style="font-size:12px;color:#777;margin-bottom:4px">Portfolio groups</div>
            <div style="font-size:22px;font-weight:800;color:#7A5000">@((Model.Groups ?? Array.Empty<AccessGroupListItemDto>()).Count(g => g.GroupTypeCode == "PortfolioGroup"))</div>
        </div>
        <div style="background:#fff;border:1px solid #e8e8e6;border-radius:8px;padding:12px 14px">
            <div style="font-size:12px;color:#777;margin-bottom:4px">Portfolio sub-groups</div>
            <div style="font-size:22px;font-weight:800;color:#185FA5">@((Model.Groups ?? Array.Empty<AccessGroupListItemDto>()).Count(g => g.GroupTypeCode == "PortfolioSubGroup"))</div>
        </div>
        <div style="background:#fff;border:1px solid #e8e8e6;border-radius:8px;padding:12px 14px">
            <div style="font-size:12px;color:#777;margin-bottom:4px">Assigned users</div>
            <div style="font-size:22px;font-weight:800;color:#C41230">@((Model.Groups ?? Array.Empty<AccessGroupListItemDto>()).Sum(g => g.AssignedUserCount))</div>
        </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:12px;flex-wrap:wrap">
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <div class="clearable-input" style="width:280px">
                <input class="fi" id="groups-search" type="text" placeholder="Group name or ID..."
                       value="@groupSearch"
                       oninput="toggleGroupsSearchClear(); searchGroups()">
                <button class="clear-input-btn" id="groups-search-clear" type="button"
                        onclick="clearGroupsSearch()"
                        aria-label="Clear group search"
                        title="Clear group search">x</button>
            </div>
            <div class="clearable-input" style="width:300px">
                <input class="fi" id="groups-org-search" type="text" placeholder="Organization name or ID..."
                       value="@groupOrgSearch"
                       oninput="toggleGroupsOrgSearchClear(); searchGroups()">
                <button class="clear-input-btn" id="groups-org-search-clear" type="button"
                        onclick="clearGroupsOrgSearch()"
                        aria-label="Clear organization search"
                        title="Clear organization search">x</button>
            </div>
            <select class="fi" id="groups-type" style="width:210px" onchange="searchGroups()">
                <option value="">All group types</option>
                <option value="PortfolioGroup" selected="@(groupType == "PortfolioGroup" ? "selected" : null)">Portfolio groups</option>
                <option value="PortfolioSubGroup" selected="@(groupType == "PortfolioSubGroup" ? "selected" : null)">Portfolio sub-groups</option>
            </select>
            <label style="display:flex;align-items:center;gap:7px;font-size:13px;color:#555">
                <input type="checkbox" id="groups-include-inactive" onchange="searchGroups()" @(includeInactive.Equals("false", StringComparison.OrdinalIgnoreCase) ? "" : "checked")>
                Include inactive
            </label>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <span id="groups-count" style="font-size:13px;color:#aaa">@((Model.Groups?.Count ?? 0)) groups</span>
            <button class="bec" onclick="reseedGroups()">Reseed system groups</button>
        </div>
    </div>
    <div class="filter-loading" id="admin-filter-loading" hidden style="padding-top:0;margin-bottom:12px">
        <div class="filter-spinner"></div>
        <span class="filter-loading-text">Updating results...</span>
    </div>

    <div class="panel" style="padding:0">
        <table class="dt">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Parent portfolio</th>
                    <th>Effective orgs</th>
                    <th>Assigned users</th>
                    <th>Status</th>
                    <th style="width:110px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Groups != null)
                {
                    @foreach (var group in Model.Groups)
                    {
                        <tr>
                            <td>
                                <strong>@group.Name</strong>
                                <div style="font-size:12px;color:#888">
                                    @(group.OrganizationId.HasValue ? $"Organization {group.OrganizationId}" : group.PortfolioId.HasValue ? $"Portfolio {group.PortfolioId}" : "No source ID")
                                    @(group.IsSystemManaged ? " · System managed" : "")
                                </div>
                            </td>
                            <td><span class="tag @(group.GroupTypeCode == "PortfolioGroup" ? "te" : "tn2")">@group.GroupTypeName</span></td>
                            <td>@(group.ParentPortfolioName ?? "-")</td>
                            <td>@group.EffectiveOrganizationCount</td>
                            <td>@group.AssignedUserCount</td>
                            <td><span class="tag @(group.IsActive ? "tc" : "tn2")">@(group.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <button class="rbtn" data-group-id="@group.AccessGroupId" onclick="openGroupDetailFromButton(this)">View</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
const TOKEN = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
const EMPTY_GUID = '00000000-0000-0000-0000-000000000000';
const SELECTED_QUIZ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedQuiz, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
const ACCESS_GROUP_OPTIONS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.Groups ?? Array.Empty<AccessGroupListItemDto>()).Where(g => g.IsActive).ToList(), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
const QUIZ_LINK_LANGUAGES = [
    ['en', 'EN'],
    ['de', 'DE'],
    ['es', 'ES'],
    ['fr', 'FR'],
    ['pt', 'PT']
];
let selectedImpersonationUser = null;

function openAddQuizModal() {
    openModal(`
        <h3 style="font-size:16px;font-weight:700;margin-bottom:16px">Add quiz</h3>
        <div class="fg" style="margin-bottom:20px">
            <label class="fl2">Title</label>
            <input class="fi" id="new-quiz-title" placeholder="Quiz title" style="width:100%;margin-top:4px">
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end">
            <button class="bex" onclick="closeModal()">Cancel</button>
            <button class="bec" onclick="saveNewQuiz()">Add quiz</button>
        </div>`);
}

async function saveNewQuiz() {
    const title = document.getElementById('new-quiz-title').value.trim();
    if (!title) { alert('Title is required.'); return; }
    const resp = await fetch('/admin/cms/quiz/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify({ title })
    });
    if (resp.ok) { closeModal(); location.reload(); }
    else alert('Failed to add quiz.');
}

function openEditQuizModalFromButton(button) {
    openEditQuizModal(button.dataset.quizId, button.dataset.quizTitle, SELECTED_QUIZ);
}

function openCopyQuizLinkModalFromButton(button) {
    openCopyQuizLinkModal(button.dataset.quizId, button.dataset.quizTitle, button.dataset.quizPublished === 'true');
}

function openCopyQuizLinkModal(quizId, title, isPublished = true) {
    openModal(`
        <h3 style="font-size:16px;font-weight:700;margin-bottom:10px">Copy quiz link</h3>
        <div style="font-size:13px;color:#555;margin-bottom:16px">${escHtml(title)}</div>
        ${isPublished ? '' : '<div class="draft-copy-note">Draft links are only available to Super Admin users until the quiz is published.</div>'}
        <div class="copy-link-list">
            ${QUIZ_LINK_LANGUAGES.map(([code, label]) => {
                const url = learnerQuizUrl(quizId, code);
                return `
                    <div class="copy-link-row">
                        <span class="admin-lang-chip ${code === 'en' ? 'on' : ''}">${label}</span>
                        <input class="fi copy-link-input" value="${escAttr(url)}" readonly>
                        <button class="rbtn" onclick="copyQuizLink('${quizId}', '${code}', this)">Copy quiz link</button>
                    </div>`;
            }).join('')}
        </div>
        <div id="copy-link-status" class="copy-link-status"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px">
            <button class="bex" onclick="closeModal()">Close</button>
        </div>`);
}

function learnerQuizUrl(quizId, lang) {
    return new URL(`/learner/quiz/open/${quizId}?lang=${encodeURIComponent(lang)}`, window.location.origin).toString();
}

async function copyQuizLink(quizId, lang, button) {
    const url = learnerQuizUrl(quizId, lang);
    try {
        if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(url);
        } else {
            const input = document.createElement('textarea');
            input.value = url;
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            input.remove();
        }
        document.getElementById('copy-link-status').textContent = `Copied ${lang.toUpperCase()} quiz link.`;
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy quiz link'; }, 1200);
    } catch {
        document.getElementById('copy-link-status').textContent = 'Copy failed. Select the link and copy it manually.';
    }
}

function publishQuizFromButton(button) {
    publishQuiz(button.dataset.quizId, button.dataset.quizTitle);
}

async function publishQuiz(quizId, title) {
    if (!confirm(`Publish "${title}"?\n\nDraft test attempts for this quiz will be removed and the quiz will become visible to learners.`)) return;

    const resp = await fetch(`/admin/cms/quiz/${quizId}/publish`, {
        method: 'PUT',
        headers: { 'RequestVerificationToken': TOKEN }
    });

    if (resp.ok) {
        location.reload();
        return;
    }

    let error = 'Failed to publish quiz.';
    try {
        const body = await resp.json();
        error = body.error || error;
    } catch {}
    alert(error);
}

function openSelectedQuizEditor() {
    if (!SELECTED_QUIZ) { closeModal(); return; }
    openEditQuizModal(SELECTED_QUIZ.quizId, SELECTED_QUIZ.title, SELECTED_QUIZ);
}

function openEditQuizModal(quizId, title, quiz = null) {
    const questions = quiz?.questions ?? [];
    openModal(`
        <div class="quiz-edit-modal">
        <h3 style="font-size:16px;font-weight:700;margin-bottom:16px">Edit quiz</h3>
        <div class="fg" style="margin-bottom:14px">
            <label class="fl2">Title</label>
            <input class="fi" id="edit-quiz-title" value="${escAttr(title)}" style="width:100%;margin-top:4px">
        </div>
        <div class="quiz-edit-toolbar">
            <div style="font-size:12px;color:#888">${questions.length} question${questions.length === 1 ? '' : 's'}</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button class="bex" onclick="openAddQuestionModal('${quizId}')">+ Add question</button>
                <button class="bec" onclick="saveQuiz('${quizId}')">Save quiz title</button>
            </div>
        </div>
        <div class="quiz-edit-list">
