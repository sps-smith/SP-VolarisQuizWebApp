    window._accessEditor[key] = (window._accessEditor[key] ?? []).filter(item => item.id !== id);
    renderAccessScopePanel();
}

function removeGroupAssignment(accessGroupId) {
    window._accessEditor.groups = (window._accessEditor.groups ?? []).filter(item => item.accessGroupId !== accessGroupId);
    renderAccessScopePanel();
}

function searchAccessOptions(type) {
    const input = document.getElementById(`${type}-search`);
    const results = document.getElementById(`${type}-results`);
    const term = input?.value.trim() ?? '';
    clearTimeout(window[`_${type}LookupTimer`]);
    if (!term) {
        if (results) results.style.display = 'none';
        return;
    }

    window[`_${type}LookupTimer`] = setTimeout(async () => {
        const endpoint = type === 'org' ? 'organizations' : 'portfolios';
        const resp = await fetch(`/admin/lookups/${endpoint}?term=${encodeURIComponent(term)}`, { headers: { Accept: 'application/json' } });
        if (!resp.ok || !results) return;
        const options = await resp.json();
        const key = type === 'org' ? 'orgs' : 'portfolios';
        const selectedIds = new Set((window._accessEditor[key] ?? []).map(item => item.id));
        const available = options.filter(item => !selectedIds.has(item.id));
        window._accessLookup = window._accessLookup ?? {};
        window._accessLookup[type] = available;
        results.innerHTML = available.length
            ? available.map(item => `<button type="button" class="access-result" data-type="${type}" data-id="${item.id}" data-name="${escAttr(item.name)}" onclick="addAccessItemFromButton(this)" style="display:block;width:100%;text-align:left;padding:9px 10px;border:0;background:#fff;cursor:pointer;font-size:13px">${escHtml(item.name)}</button>`).join('')
            : '<div style="padding:10px;font-size:13px;color:#888">No matches</div>';
        results.style.display = 'block';
    }, 250);
}

function searchGroupOptions() {
    const input = document.getElementById('group-search');
    const results = document.getElementById('group-results');
    const term = input?.value.trim().toLowerCase() ?? '';
    clearTimeout(window._groupLookupTimer);
    if (!term) {
        if (results) results.style.display = 'none';
        return;
    }

    window._groupLookupTimer = setTimeout(() => {
        if (!results) return;
        const selectedIds = new Set((window._accessEditor.groups ?? []).map(item => item.accessGroupId));
        const options = (window._accessGroupOptions ?? ACCESS_GROUP_OPTIONS ?? [])
            .filter(item => item.isActive)
            .filter(item => !selectedIds.has(item.accessGroupId))
            .filter(item =>
                String(item.name ?? '').toLowerCase().includes(term) ||
                String(item.organizationId ?? '').includes(term) ||
                String(item.portfolioId ?? '').includes(term));
        window._accessLookup = window._accessLookup ?? {};
        window._accessLookup.group = options;
        results.innerHTML = options.length
            ? options.map(item => `<button type="button" class="access-result" data-group-id="${escAttr(item.accessGroupId)}" data-name="${escAttr(item.name)}" data-type-code="${escAttr(item.groupTypeCode)}" data-count="${Number(item.effectiveOrganizationCount ?? 0)}" onclick="addGroupItemFromButton(this)" style="display:block;width:100%;text-align:left;padding:9px 10px;border:0;background:#fff;cursor:pointer;font-size:13px">${escHtml(item.name)} <span style="color:#888">(${Number(item.effectiveOrganizationCount ?? 0)} orgs)</span></button>`).join('')
            : '<div style="padding:10px;font-size:13px;color:#888">No matches</div>';
        results.style.display = 'block';
    }, 250);
}

function addHighlightedAccessItem(type) {
    const input = document.getElementById(`${type}-search`);
    const query = input?.value.trim().toLowerCase() ?? '';
    const results = (window._accessLookup?.[type] ?? []);
    if (!results.length) return;

    const exact = results.find(item => String(item.name).toLowerCase() === query);
    addAccessItem(type, Number((exact ?? results[0]).id), (exact ?? results[0]).name);
}

function addHighlightedGroupItem() {
    const input = document.getElementById('group-search');
    const query = input?.value.trim().toLowerCase() ?? '';
    const results = (window._accessLookup?.group ?? []);
    if (!results.length) return;

    const exact = results.find(item => String(item.name).toLowerCase() === query);
    addGroupAssignment(exact ?? results[0]);
}

function userInitials(fullName) {
    const parts = String(fullName || '').trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return '??';
    return parts.slice(0, 2).map(p => p[0]?.toUpperCase() ?? '').join('') || '??';
}

function roleLabel(role) {
    switch (role) {
        case 'ReportingAdmin': return 'Reporting admin';
        case 'OrgAdmin': return 'Reporting admin';
        case 'PortfolioAdmin': return 'Reporting admin';
        case 'GlobalAdmin': return 'Global admin';
        default: return 'Learner';
    }
}

function normalizeRoleForEditor(role) {
    return role === 'OrgAdmin' || role === 'PortfolioAdmin' ? 'ReportingAdmin' : (role || 'Learner');
}

function addAccessItemFromButton(button) {
    addAccessItem(button.dataset.type, Number(button.dataset.id), button.dataset.name);
}

function addGroupItemFromButton(button) {
    addGroupAssignment({
        accessGroupId: button.dataset.groupId,
        name: button.dataset.name,
        groupTypeCode: button.dataset.typeCode,
        effectiveOrganizationCount: Number(button.dataset.count ?? 0),
        isActive: true
    });
}

function addAccessItem(type, id, name) {
    const key = type === 'org' ? 'orgs' : 'portfolios';
    const items = window._accessEditor[key] ?? [];
    if (!items.some(item => item.id === id)) {
        items.push({ id, name });
        window._accessEditor[key] = items;
    }
    renderAccessScopePanel();
}

function addGroupAssignment(item) {
    const groups = window._accessEditor.groups ?? [];
    if (!groups.some(group => group.accessGroupId === item.accessGroupId)) {
        groups.push({
            accessGroupId: item.accessGroupId,
            name: item.name,
            groupTypeCode: item.groupTypeCode,
            effectiveOrganizationCount: item.effectiveOrganizationCount ?? 0,
            isActive: item.isActive ?? true
        });
        window._accessEditor.groups = groups;
    }
    renderAccessScopePanel();
}

