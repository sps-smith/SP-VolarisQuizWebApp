function clearLearnerFilter() {
    const search = document.getElementById('fl-search');
    if (!search) return;
    search.value = '';
    toggleSearchClear();
    applyFilters(0);
    search.focus();
}

function clearDomainFilter() {
    if (typeof dfPending !== 'undefined') {
        const domain = document.getElementById('fl-domain');
        const hasSelection = dfPending.size > 0;
        if (domain) domain.value = '';
        if (!hasSelection) {
            dfRefresh();
            toggleDomainClear();
            return;
        }
        dfClearPending();
        dfSetDropdownState(false);
        applyFilters(0, null, []);
        return;
    }

    const domain = document.getElementById('fl-domain');
    const errDomain = document.getElementById('err-domain');
    if (!domain) return;
    domain.value = '';
    domain.classList.remove('date-invalid');
    if (errDomain) errDomain.textContent = '';
    toggleDomainClear();
    applyFilters(0);
    domain.focus();
}

function resetDetailToggle(button) {
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', button.dataset.showLabel || 'Show module details');
    button.title = 'Show module details';

    const row = button.closest('.user-row');
    if (row) row.classList.remove('details-open');
}

function toggleUserDetails(button) {
    const detailId = button.getAttribute('aria-controls');
    const detailRow = detailId ? document.getElementById(detailId) : null;
    if (!detailRow) return;

    const shouldOpen = button.getAttribute('aria-expanded') !== 'true';

    document.querySelectorAll('.user-detail-row').forEach(row => {
        row.hidden = true;
    });
    document.querySelectorAll('.detail-toggle[aria-expanded="true"]').forEach(resetDetailToggle);

    if (!shouldOpen) return;

    detailRow.hidden = false;
    button.setAttribute('aria-expanded', 'true');
    button.setAttribute('aria-label', button.dataset.hideLabel || 'Hide module details');
    button.title = 'Hide module details';

    const row = button.closest('.user-row');
    if (row) row.classList.add('details-open');
}

function applyFilters(delay = 400, companies = null, domains = null) {
    if (!validateDomain()) return;

    const searchInput = document.getElementById('fl-search');
    const moduleInput = document.getElementById('fl-module');
    const fromInput = document.getElementById('fl-from');
    const toInput = document.getElementById('fl-to');
    const search = searchInput ? searchInput.value : '';
    const module = moduleInput ? moduleInput.value : '';
    const from   = fromInput ? fromInput.value : '';
    const to     = toInput ? toInput.value : '';
    const includeLeavers = document.getElementById('fl-include-leavers')?.checked ?? false;
    const statusValues = [...sfPending];
    const params = new URLSearchParams();
    if (search) params.set('SearchTerm', search);
    const selectedDomainValues = domains !== null
        ? domains
        : (typeof dfPending !== 'undefined' && dfPending.size > 0 ? [...dfPending] : []);
    selectedDomainValues.forEach(d => params.append('Domains', normalizeDomainInput(d)));
    if (module) params.set('ModuleOrder', module);
    statusValues.forEach(status => params.append('Status', status));
    // Date filter only applies when BOTH dates are set - never send a partial range
    if (from && to) {
        params.set('FromDate', from);
        params.set('ToDate', to);
    }

    clearTimeout(window._filterTimer);
    window._filterTimer = setTimeout(() => {
        const loader = document.getElementById('filter-loading');
        if (loader) loader.hidden = false;
        const selectedDomainValues = domains !== null
            ? domains
            : (typeof dfPending !== 'undefined' && dfPending.size > 0 ? [...dfPending] : []);
        const coList = companies !== null ? companies : @Html.Raw(selectedJson);
        const payload = {
            searchTerm: search || null,
            domain: selectedDomainValues.length === 1 ? normalizeDomainInput(selectedDomainValues[0]) : null,
            moduleOrder: module ? Number(module) : null,
            lastActiveDays: null,
            companies: coList.length ? coList.map(Number) : [],
            portfolio: null,
            fromDate: from && to ? new Date(`${from}T00:00:00Z`).toISOString() : null,
            toDate: from && to ? new Date(`${to}T23:59:59.999Z`).toISOString() : null,
            domains: selectedDomainValues.length ? selectedDomainValues.map(d => normalizeDomainInput(d)) : [],
            refreshToken: null,
            status: statusValues,
            includeLeavers: includeLeavers
        };

        fetch('/reporting/state', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(async resp => {
                if (resp.ok) return resp.json();
                const text = await resp.text();
                throw new Error(text || `Failed to save reporting state (HTTP ${resp.status}).`);
            })
            .then(data => {
                window.location.href = `${window.location.pathname}?stateToken=${encodeURIComponent(data.token)}`;
            })
            .catch(err => {
                if (loader) loader.hidden = true;
                alert(err.message || 'Failed to apply filters.');
            });
    }, delay);
}

// Export the current report respecting all active filters (incl. selected companies).
// Posts the applied filter as JSON with the antiforgery token in the header - the
// export actions bind [FromBody], so a plain form POST would send an empty filter.
const EXPORT_FILTER = @Html.Raw(exportFilterJson);
const AVAILABLE_COMPANY_GROUPS = @Html.Raw(groupsJson);

function setReportLoading(isLoading, text = 'Generating report…') {
    const loader = document.getElementById('filter-loading');
    const textEl = document.querySelector('#filter-loading .filter-loading-text');
    if (loader) loader.hidden = !isLoading;
    if (textEl) textEl.textContent = isLoading ? text : 'Updating results…';
}

async function exportReport(format, btn) {
    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenEl ? tokenEl.value : '';
    const label = btn ? btn.textContent : '';
    setReportLoading(true);
    if (btn) { btn.disabled = true; btn.textContent = 'Exporting…'; }
    try {
        const resp = await fetch('/reporting/export/' + format, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(EXPORT_FILTER)
        });
        if (!resp.ok) { alert('Export failed (HTTP ' + resp.status + ').'); return; }
        const blob = await resp.blob();
        let filename = format === 'xlsx'
            ? 'Volaris101_Detail_Activity_Report.xlsx'
            : 'Volaris101_Report.' + (format === 'csv' ? 'csv' : 'xlsx');
        const cd = resp.headers.get('Content-Disposition');
        if (cd) { const m = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(cd); if (m) filename = decodeURIComponent(m[1]); }
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
    } catch (e) {
        alert('Export failed: ' + e.message);
    } finally {
        if (btn) { btn.disabled = false; btn.textContent = label; }
        setReportLoading(false);
    }
}

function validatePortfolioReportSelection() {
    const selectedIds = (EXPORT_FILTER.companies && EXPORT_FILTER.companies.length > 0)
        ? [...new Set(EXPORT_FILTER.companies.filter(id => id > 0))]
        : [...new Set(AVAILABLE_COMPANY_GROUPS.flatMap(g => g.companies.map(c => c.organizationId)).filter(id => id > 0))];

    if (selectedIds.length === 0) {
        alert('Select at least one organization to generate the certification report.');
        return false;
    }

    const portfolios = [...new Set(
        AVAILABLE_COMPANY_GROUPS
            .filter(g => g.companies.some(c => selectedIds.includes(c.organizationId)))
            .map(g => g.portfolioName)
            .filter(Boolean)
    )];

    if (portfolios.length !== 1) {
        alert('Certification report requires all selected organizations to belong to the same portfolio.');
        return false;
    }

    return true;
}

