@model Volaris101.Web.Controllers.ReportingPageModel
@using Microsoft.AspNetCore.Html
@using Volaris101.Application.Interfaces
@using Volaris101.Domain.Entities
@using System.Text.Json
@inject ICurrentUserContext UserCtx
@{
    ViewData["Title"] = "Reporting";
    ViewData["ActiveTab"] = "reporting";

    var isOverviewTab = Model.ActiveTab == "overview";
    var tabOverview = Model.ActiveTab == "overview" ? "on" : "";
    var tabUsers    = Model.ActiveTab == "users"    ? "on" : "";
    var tabExport   = Model.ActiveTab == "export"   ? "on" : "";
    var tabDashboard = Model.ActiveTab == "dashboard" ? "on" : "";
    var isDashboardTab = Model.ActiveTab == "dashboard";

    // Module dropdown - built from quizzes in the DB
    var moduleOpts = new System.Text.StringBuilder();
    moduleOpts.Append("<select class=\"fi\" id=\"fl-module\" onchange=\"applyFilters(); updateFilterControlStates()\">");
    moduleOpts.Append("<option value=\"\">All modules</option>");
    var quizList = Model.Quizzes ?? new List<Quiz>();
    var moduleCount = Model.Filter.ModuleOrder.HasValue ? 1 : quizList.Count;
    var moduleNoun = moduleCount == 1 ? "module" : "modules";
    foreach (var quiz in quizList.OrderBy(q => q.DisplayOrder))
    {
        var label = $"M{quiz.DisplayOrder}: {quiz.GetTitle("en")}";
        var sel   = Model.Filter.ModuleOrder == quiz.DisplayOrder ? " selected" : "";
        moduleOpts.Append($"<option value=\"{quiz.DisplayOrder}\"{sel}>{System.Web.HttpUtility.HtmlEncode(label)}</option>");
    }
    moduleOpts.Append("</select>");
    var moduleHtml = new HtmlString(moduleOpts.ToString());

    // Pre-format existing date values for the date inputs (yyyy-MM-dd)
    var fromVal = Model.Filter.FromDate.HasValue
        ? Model.Filter.FromDate.Value.ToString("yyyy-MM-dd") : "";
    var toVal   = Model.Filter.ToDate.HasValue
        ? Model.Filter.ToDate.Value.ToString("yyyy-MM-dd")   : "";
    var hasDateRange = !string.IsNullOrEmpty(fromVal) && !string.IsNullOrEmpty(toVal);
    var hasExportPreviewRows = Model.ExportPreview is { Count: > 0 };
    var selectedStatuses = (Model.Filter.Status ?? Array.Empty<string>())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Select(s => s.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var selectedStatusJson = JsonSerializer.Serialize(selectedStatuses);
    var selectedStatusLabel = selectedStatuses.Count == 0 || selectedStatuses.Count == 3
        ? "All statuses"
        : string.Join(", ", selectedStatuses);

    // Max date = today
    var today = DateTimeOffset.UtcNow.ToString("yyyy-MM-dd");

    // Company filter setup
    var allGroups        = Model.AvailableCompanies ?? new List<Volaris101.Application.Dtos.CompanyGroupDto>();
    var allCompanies     = allGroups
        .SelectMany(g => g.Companies)
        .GroupBy(c => c.OrganizationId)
        .Select(g => g.First())
        .ToList();
    var totalCompanies   = allCompanies.Count;
    var showCompanyFilter = totalCompanies > 1;
    var selectedCompanyIds = (Model.Filter.Companies ?? Array.Empty<int>())
        .Where(id => id > 0)
        .Distinct()
        .ToList();
    var companyLabelLookup = allCompanies.ToDictionary(
        c => c.OrganizationId,
        c => c.CompanyName);
    var selectedCompanyLabels = selectedCompanyIds
        .Select(id => companyLabelLookup.TryGetValue(id, out var label) ? label : $"Organization {id}")
        .ToList();
    var groupsJson       = JsonSerializer.Serialize(allGroups.Select(g => new
    {
        portfolioName = g.PortfolioName,
        companies = g.Companies.Select(c => new
        {
            organizationId = c.OrganizationId,
            companyName = c.CompanyName,
            displayName = c.CompanyName,
            isPortfolio = c.IsPortfolio
        })
    }));
    var organizationChildrenJson = Model.OrganizationChildrenJson ?? "{}";
    var portfolioOrganizationIdsJson = Model.PortfolioOrganizationIdsJson ?? "[]";
    var selectedJson     = JsonSerializer.Serialize(selectedCompanyIds);
    var hasSidebar       = allGroups.Count > 1;

    var allDomains = (Model.Domains ?? Array.Empty<string>())
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Select(d => d.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(d => d)
        .ToList();
    var showDomainFilter = allDomains.Count > 1;
    var selectedDomains = (Model.Filter.Domains is { Length: > 0 }
            ? Model.Filter.Domains
            : !string.IsNullOrWhiteSpace(Model.Filter.Domain)
                ? new[] { Model.Filter.Domain! }
                : Array.Empty<string>())
        .Select(d => d.Trim().TrimStart('@'))
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(d => d)
        .ToList();
    var domainInputValue = !string.IsNullOrWhiteSpace(Model.Filter.Domain)
        ? Model.Filter.Domain!
        : selectedDomains.Count == 1
            ? "@" + selectedDomains[0]
            : "";
    var domainsJson     = JsonSerializer.Serialize(allDomains);
    var selectedDomainsJson = JsonSerializer.Serialize(selectedDomains);
    var hasExportFilterSelection =
        !string.IsNullOrWhiteSpace(Model.Filter.SearchTerm) ||
        !string.IsNullOrWhiteSpace(Model.Filter.Domain) ||
        selectedDomains.Count > 0 ||
        Model.Filter.ModuleOrder.HasValue ||
        Model.Filter.LastActiveDays.HasValue ||
        selectedCompanyIds.Count > 0 ||
        !string.IsNullOrWhiteSpace(Model.Filter.Portfolio) ||
        hasDateRange ||
        selectedStatuses.Count > 0 ||
        Model.Filter.IncludeLeavers;

    // Current applied filter, serialized for the export POST (sent as JSON body)
    var exportFilterJson = JsonSerializer.Serialize(new
    {
        searchTerm     = Model.AppliedFilter.SearchTerm,
        domain         = Model.AppliedFilter.Domain,
        domains        = selectedDomains,
        moduleOrder    = Model.AppliedFilter.ModuleOrder,
        lastActiveDays = Model.AppliedFilter.LastActiveDays,
        companies      = Model.AppliedFilter.Companies,
        portfolio      = Model.AppliedFilter.Portfolio,
        fromDate       = Model.AppliedFilter.FromDate,
        toDate         = Model.AppliedFilter.ToDate,
        refreshToken   = Model.AppliedFilter.RefreshToken,
        status         = Model.AppliedFilter.Status,
        includeLeavers = Model.AppliedFilter.IncludeLeavers
    });

    // Carry the current filter query string across the tab links so filters persist
    // between Overview / User Activity / Reports (empty => no trailing '?')
    var tabQs = Context.Request.QueryString.Value;
    if (string.IsNullOrEmpty(tabQs) || tabQs == "?") { tabQs = ""; }
}

<div class="atabs">
    <a class="atab @tabOverview" href="/reporting@(tabQs)">Overview</a>
    <a class="atab @tabUsers"    href="/reporting/users@(tabQs)">User Activity</a>
    <a class="atab @tabExport"   href="/reporting/export@(tabQs)">Reports</a>
    @if (UserCtx.IsGlobalAdmin)
    {
        <a class="atab @tabDashboard" href="/reporting/dashboard">Dashboard</a>
    }
    @if (Model.ShowHowToButton)
    {
        <button type="button" class="report-howto-btn" onclick="openHowToGuide()">How To</button>
    }
</div>

@* Filter bar *@
@{
    // Company column gets extra width so "Filter by company" fits on one line;
    // the Clear-dates column sizes to its (reduced) button content.
    var fbarCols = isOverviewTab
        ? (showCompanyFilter ? "170px 230px 110px 170px minmax(260px, 1fr)" : "170px 230px 110px minmax(260px, 1fr)")
        : (showCompanyFilter ? "300px 170px 230px 110px 170px" : "300px 170px 230px 110px");
}
@if (!isDashboardTab)
{
<div class="fbar" style="grid-template-columns:@fbarCols;">
    @if (!isOverviewTab)
    {
        <div class="fg">
            <label class="fl2">Learner</label>
            <div class="clearable-input">
            <input class="fi" id="fl-search" type="text" placeholder="Name or email..."
                   value="@Model.Filter.SearchTerm" oninput="toggleSearchClear(); applyFilters()">
                <button class="clear-input-btn" id="fl-search-clear" onclick="clearLearnerFilter()" type="button"
                        aria-label="Clear learner filter" title="Clear learner filter">x</button>
            </div>
        </div>
    }
        <div class="fg">
            <label class="fl2">Domain</label>
            <div class="domain-filter-wrap">
                <div class="clearable-input">
                    <input class="fi" id="fl-domain" type="text" placeholder="example.com"
                           value="@domainInputValue"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-expanded="false"
                           aria-controls="df-dropdown"
                           oninput="toggleDomainClear(); validateDomain(); if (typeof dfAllowAutoOpen !== 'undefined') dfAllowAutoOpen = true; if (typeof dfRefresh === 'function') dfRefresh();"
                           onfocus="if (typeof dfRefresh === 'function') dfRefresh();"
                           onkeydown="if (typeof dfHandleKeydown === 'function') dfHandleKeydown(event)">
                    <button class="clear-input-btn" id="fl-domain-clear" onclick="clearDomainFilter()" type="button"
                            aria-label="Clear domain filter" title="Clear domain filter">x</button>
                </div>
                @if (showDomainFilter)
                {
                    <div class="df-dropdown" id="df-dropdown" hidden>
                        <div class="df-dropdown-hd">
                            <span id="df-dropdown-title">Matching domains</span>
                            <span class="df-dropdown-count" id="df-dropdown-count"></span>
                        </div>
                        <div class="df-dropdown-list" id="df-dropdown-list"></div>
                    </div>
                    <div class="cf-chips" id="df-chips"></div>
                }
                <span class="date-err" id="err-domain"></span>
            </div>
        </div>
        <div class="fg">
            <label class="fl2">Module</label>
            @moduleHtml
        </div>
        <div class="fg status-filter-wrap">
            <label class="fl2">Status</label>
            <button type="button" class="cf-trigger" id="sf-trigger" onclick="sfToggleDropdown()" aria-haspopup="dialog" aria-expanded="false">
                <span id="sf-trigger-label">@selectedStatusLabel</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="df-dropdown sf-dropdown" id="sf-dropdown" hidden onclick="event.stopPropagation()">
                <div class="df-dropdown-hd">
                    <span>Filter by status</span>
                    <span class="df-dropdown-count" id="sf-count"></span>
                </div>
                <div class="df-dropdown-list" id="sf-list">
                    <label class="sf-option"><input type="checkbox" value="Completed" data-status-option onchange="sfSyncFromCheckboxes()"><span>Completed</span></label>
                    <label class="sf-option"><input type="checkbox" value="In Progress" data-status-option onchange="sfSyncFromCheckboxes()"><span>In Progress</span></label>
                    <label class="sf-option"><input type="checkbox" value="Not Started" data-status-option onchange="sfSyncFromCheckboxes()"><span>Not Started</span></label>
                </div>
                <div class="sf-footer">
                    <button type="button" class="sf-clear" onclick="sfClear()">Clear</button>
                </div>
            </div>
        </div>
    @if (showCompanyFilter)
    {
        <div class="fg" id="fg-company">
            <label class="fl2">Organization</label>
            <button type="button" class="cf-trigger" id="cf-trigger" onclick="cfOpenModal()" aria-haspopup="dialog" aria-label="Filter by organization">
                <span>Filter by organization</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
        </div>
    }
    @if (isOverviewTab)
    {
        <div class="overview-date-filters" aria-label="Date filters">
            <div class="date-field-wrap overview-date-field">
                <label class="fl2 date-label" for="fl-from">From Date</label>
                <input class="fi date-input overview-date-input" id="fl-from" type="date"
                       value="@fromVal" max="@today"
                       onchange="validateAndApply()"
                       oninput="validateAndApply()">
                <span class="date-err" id="err-from"></span>
            </div>
            <div class="date-field-wrap overview-date-field overview-date-field--to">
                <label class="fl2 date-label" for="fl-to">To Date</label>
                <input class="fi date-input overview-date-input" id="fl-to" type="date"
                       value="@toVal" max="@today"
                       onchange="validateAndApply()"
                       oninput="validateAndApply()">
                <span class="date-err" id="err-to"></span>
                <button class="date-clear-btn date-clear-btn-below" id="date-clear-btn" onclick="clearDates()" type="button"
                        hidden="@(string.IsNullOrEmpty(fromVal) && string.IsNullOrEmpty(toVal) ? "hidden" : null)">Clear dates</button>
            </div>
        </div>
    }
    else
    {
        <table class="date-filter-table" aria-label="Date filters">
            <tbody>
                <tr>
                    <td class="date-field">
                        <div class="date-field-wrap">
                            <label class="fl2 date-label" for="fl-from">From Date</label>
                            <input class="fi date-input" id="fl-from" type="date"
                                   value="@fromVal" max="@today"
                                   onchange="validateAndApply()"
                                   oninput="validateAndApply()">
                            <span class="date-err" id="err-from"></span>
                        </div>
                    </td>
                    <td class="date-field">
                        <div class="date-field-wrap">
                            <label class="fl2 date-label" for="fl-to">To Date</label>
                            <input class="fi date-input" id="fl-to" type="date"
                                   value="@toVal" max="@today"
                                   onchange="validateAndApply()"
                                   oninput="validateAndApply()">
                            <span class="date-err" id="err-to"></span>
                        </div>
                    </td>
                    <td class="date-actions">
                        <div class="date-actions-inner">
                            <button class="date-clear-btn" id="date-clear-btn" onclick="clearDates()" type="button"
                                    hidden="@(string.IsNullOrEmpty(fromVal) && string.IsNullOrEmpty(toVal) ? "hidden" : null)">Clear dates</button>
                        </div>
                    </td>
                    <td class="include-leavers-cell">
                        <label class="include-leavers-toggle" for="fl-include-leavers">
                            <span class="fl2">Include Leavers</span>
                            <span class="toggle-switch">
                            <input id="fl-include-leavers" type="checkbox" role="switch" aria-label="Include Leavers"
                                   @(Model.Filter.IncludeLeavers ? "checked" : null)
                                   onchange="applyFilters(0)">
                                <span class="toggle-slider" aria-hidden="true"></span>
                            </span>
                        </label>
                    </td>
                </tr>
            </tbody>
        </table>
    }
    @if (isOverviewTab)
    {
        <div class="include-leavers-row">
            <label class="include-leavers-toggle" for="fl-include-leavers">
                <span class="fl2">Include Leavers</span>
                <span class="toggle-switch">
                    <input id="fl-include-leavers" type="checkbox" role="switch" aria-label="Include Leavers"
                           @(Model.Filter.IncludeLeavers ? "checked" : null)
                           onchange="applyFilters(0)">
                    <span class="toggle-slider" aria-hidden="true"></span>
                </span>
            </label>
        </div>
    }
    <div class="filter-loading" id="filter-loading" hidden>
        <div class="filter-spinner"></div>
        <span class="filter-loading-text">Updating results...</span>
    </div>
</div>
}

@* Company filter modal - only rendered when multi-company filter applies *@
@if (!isDashboardTab && showCompanyFilter)
{
    <div id="cf-overlay" class="cf-overlay" role="dialog" aria-modal="true" aria-label="Select organizations" hidden>
        <div class="cf-modal" onclick="event.stopPropagation()">
            <div class="cf-modal-hd">
                <span class="cf-modal-title">Select organizations</span>
                <div class="cf-modal-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <input type="text" id="cf-search" placeholder="Search organizations..." oninput="cfOnSearch(this.value)" autocomplete="off">
                    <button type="button" class="clear-input-btn" id="cf-search-clear" onclick="cfClearSearch()" aria-label="Clear organization search" title="Clear organization search">x</button>
                </div>
                <button type="button" class="cf-modal-close" onclick="cfCloseModal(false)" aria-label="Close">x</button>
            </div>
            <div class="cf-select-all" onclick="cfToggleAll()">
                <input type="checkbox" id="cf-chk-all" onclick="event.stopPropagation();cfToggleAll()">
                <span id="cf-sa-label">Select all organizations</span>
                <span class="cf-sa-hint" id="cf-sa-hint"></span>
            </div>
            <div class="cf-body">
                @if (hasSidebar)
                {
                    <div class="cf-sidebar" id="cf-sidebar">
                        <button type="button" class="cf-sb-all cf-sb-active" id="cf-sb-all" onclick="cfSetActivePf(null)">All portfolios</button>
                        @foreach (var grp in allGroups)
                        {
                            <button type="button" class="cf-sb-item" data-pf="@grp.PortfolioName" onclick="cfSetActivePf(this.dataset.pf)">
                                @grp.PortfolioName
                                <span class="cf-sb-badge" data-pf-badge="@grp.PortfolioName" hidden></span>
                            </button>
                        }
                    </div>
                }
                <div class="cf-pane" id="cf-pane">
                    @foreach (var grp in allGroups)
                    {
                        <div class="cf-pf-section" data-section="@grp.PortfolioName">
                            <div class="cf-pf-hd">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                                <span>@grp.PortfolioName</span>
                                <span class="cf-pf-count" data-pf-count="@grp.PortfolioName">0 / @grp.Companies.Count selected</span>
                                <button type="button" class="cf-pf-selall" data-pf-selall="@grp.PortfolioName" onclick="cfTogglePortfolio(this.dataset.pfSelall)">Select all</button>
                            </div>
                            <div class="cf-grid">
                                @foreach (var co in grp.Companies)
                                {
                                    <div class="cf-co-row"
                                         data-company-id="@co.OrganizationId"
                                         data-company-name="@co.CompanyName"
                                         data-company-display="@co.CompanyName"
                                         data-portfolio="@grp.PortfolioName"
                                         onclick="cfToggleCompany(this.dataset.companyId)">
                                        <input type="checkbox"
                                               data-co-chk="@co.OrganizationId"
                                               onclick="event.stopPropagation();cfToggleCompany(this.closest('.cf-co-row').dataset.companyId)">
                                        <span class="cf-co-name">@co.CompanyName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <div class="cf-empty" id="cf-empty" hidden>No organizations match your search.</div>
                </div>
            </div>
            <div class="cf-modal-ft">
                <span class="cf-ft-count" id="cf-ft-count">No filter - showing all organizations</span>
                <div style="display:flex;gap:8px">
                    <button type="button" class="cf-btn-clear" onclick="cfClearPending()">Clear</button>
                    <button type="button" class="cf-btn-apply" onclick="cfCloseModal(true)">Apply filter</button>
                </div>
            </div>
        </div>
    </div>
}

@* Active company filter indicator - shown below the filter controls *@
@if (!isDashboardTab && showCompanyFilter && selectedCompanyIds.Any())
{
    <div class="cf-applied" id="cf-applied">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
        <span>
            @if (selectedCompanyIds.Count == totalCompanies)
            {
                <text>All organizations selected</text>
            }
            else
            {
                <text>Filtered by <strong>@selectedCompanyIds.Count</strong> of @totalCompanies organizations:</text>
                <span class="cf-applied-list">@string.Join(", ", selectedCompanyLabels)</span>
            }
        </span>
        <button type="button" class="cf-applied-clear" onclick="applyFilters(0, [])">Clear organization filter</button>
    </div>
}

@if (Model.ActiveTab == "dashboard" && Model.Dashboard != null)
{
    var dashboard = Model.Dashboard;
    var lastRefreshed = dashboard.LastRefreshedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not available";
    <div class="panel">
        <div class="ph">
            <span class="pt2">Dashboard</span>
            <span class="pc2">Last refreshed @lastRefreshed</span>
        </div>
        @if (dashboard.Rows.Any())
        {
            <div style="overflow-x:auto">
                <table class="dt">
                    <thead>
                        <tr>
                            <th>Language</th>
                            <th style="text-align:right">In Progress</th>
                            <th style="text-align:right">Completed</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in dashboard.Rows)
                        {
                            var rowStyle = row.IsTotalsRow ? "font-weight:700;" : null;
                            <tr style="@rowStyle">
                                <td>@row.LanguageName</td>
                                <td style="text-align:right">@row.InProgressCount</td>
                                <td style="text-align:right">@row.CompletedCount</td>
                                <td style="text-align:right">@row.TotalUsers</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:20px 6px;color:#666">Dashboard data is not available yet.</div>
        }
    </div>
}

@* --- Overview tab ------------------------------------------------------------ *@
@if (Model.ActiveTab == "overview")
{
    var ov = Model.Overview;
    <div class="mrow ov-summary-grid">
        <div class="mc2 ov-summary-card">
            <div class="ml2">Learners</div>
            <div class="mv">@(ov?.TotalLearners.ToString() ?? "-")</div>
        </div>
        <div class="mc2 ov-summary-card ov-summary-card-border">
            <div class="ml2">Completed</div>
            <div class="mv">@(ov?.FullyCompleted.ToString() ?? "-")</div>
            <div class="ov-summary-pct">@(ov != null ? $"{ov.CompletedPercent}%" : "-")</div>
        </div>
        <div class="mc2 ov-summary-card ov-summary-card-border">
            <div class="ml2">In Progress</div>
            <div class="mv">@(ov?.InProgress.ToString() ?? "-")</div>
            <div class="ov-summary-pct">@(ov != null ? $"{ov.InProgressPercent}%" : "-")</div>
        </div>
        <div class="mc2 ov-summary-card ov-summary-card-border">
            <div class="ml2">Not Started</div>
            <div class="mv">@(ov?.NotStarted.ToString() ?? "-")</div>
            <div class="ov-summary-pct">@(ov != null ? $"{ov.NotStartedPercent}%" : "-")</div>
        </div>
    </div>
    @if (ov != null)
    {
        <div class="panel">
            <div class="ph"><span class="pt2">Module completion rates</span></div>
            @foreach (var bar in ov.CompletionBars)
            {
                <div class="brw">
                    <div class="bl2">M@(bar.DisplayOrder): @bar.Title</div>
                    <div class="bt2"><div class="bf" style="width:@(bar.Percent)%"></div></div>
                    <div class="bpct">@bar.Percent%</div>
                </div>
            }
        </div>
        <div class="panel">
            <div class="ph"><span class="pt2">Average scores per module</span></div>
            @foreach (var bar in ov.ScoreBars)
            {
                <div class="brw">
                    <div class="bl2">M@(bar.DisplayOrder): @bar.Title</div>
                    <div class="bt2"><div class="bfb" style="width:@(bar.AvgScorePercent)%"></div></div>
                    <div class="bpct">@bar.AvgScorePercent%</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel ov-empty-panel">
            <div class="ov-empty-state">No overview data to display until you choose at least one filter.</div>
        </div>
    }
}
@* --- User Activity tab ------------------------------------------------------- *@
@if (Model.ActiveTab == "users" && Model.UserActivity != null)
{
    <div class="panel">
        <div class="ph">
            <span class="pt2">Learners</span>
            <span class="pc2">@(Model.UserActivity?.Count ?? 0) of @Model.UserActivityTotalCount users</span>
        </div>
        <table class="dt">
            <thead>
                <tr>
                    <th class="dt-icon-col"><span class="sr-only">Details</span></th>
