@section Scripts {
<script>
const today = new Date().toISOString().split('T')[0];
// Whether a date range is currently applied (both dates present on the server filter)
const DATE_FILTER_ACTIVE = @((!string.IsNullOrEmpty(fromVal) && !string.IsNullOrEmpty(toVal)).ToString().ToLowerInvariant());
const SHOW_DOMAIN_FILTER = @showDomainFilter.ToString().ToLowerInvariant();
let sfPending = new Set(@Html.Raw(selectedStatusJson));

function sfGetLabel() {
    const values = [...sfPending];
    if (values.length === 0 || values.length === 3)
        return 'All statuses';
    return values.join(', ');
}

function sfRefresh() {
    const trigger = document.getElementById('sf-trigger');
    const label = document.getElementById('sf-trigger-label');
    const count = document.getElementById('sf-count');
    const checkboxes = document.querySelectorAll('[data-status-option]');

    if (label)
        label.textContent = sfGetLabel();
    if (count)
        count.textContent = sfPending.size === 0 ? 'All statuses' : `${sfPending.size} selected`;
    if (trigger)
        trigger.classList.toggle('cf-active', sfPending.size > 0 && sfPending.size < 3);

    checkboxes.forEach(cb => {
        cb.checked = sfPending.has(cb.value);
    });

    updateFilterControlStates();
}

function sfOpenDropdown() {
    const dropdown = document.getElementById('sf-dropdown');
    const trigger = document.getElementById('sf-trigger');
    if (!dropdown || !trigger) return;
    dropdown.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
}

function sfCloseDropdown() {
    const dropdown = document.getElementById('sf-dropdown');
    const trigger = document.getElementById('sf-trigger');
    if (dropdown) dropdown.hidden = true;
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
}

function sfToggleDropdown() {
    const dropdown = document.getElementById('sf-dropdown');
    if (!dropdown) return;
    if (dropdown.hidden) sfOpenDropdown();
    else sfCloseDropdown();
}

function sfSyncFromCheckboxes() {
    const values = [...document.querySelectorAll('[data-status-option]')]
        .filter(cb => cb.checked)
        .map(cb => cb.value);
    sfPending = new Set(values);
    sfRefresh();
    applyFilters(0);
}

function sfClear() {
    sfPending = new Set();
    sfRefresh();
    applyFilters(0);
}

function openHowToGuide() {
    window.open('/reporting/how-to', '_blank', 'noopener,noreferrer');
}

document.addEventListener('click', e => {
    const wrap = document.querySelector('.status-filter-wrap');
    if (!wrap) return;
    if (!wrap.contains(e.target))
        sfCloseDropdown();
});

// -- Organization filter --------------------------------------------------------
@if (showCompanyFilter)
{
    <text>
const CF_GROUPS   = @Html.Raw(groupsJson);
const CF_CHILDREN = @Html.Raw(organizationChildrenJson);
const CF_PORTFOLIO_IDS = new Set(@Html.Raw(portfolioOrganizationIdsJson));
const CF_ALL      = CF_GROUPS.flatMap(g => g.companies);
const CF_SIDEBAR  = @hasSidebar.ToString().ToLower();
let   cfPending   = new Set(@Html.Raw(selectedJson));
let   cfActivePf  = null;
let   cfSearch    = '';

function cfChildIds(parentId) {
    const children = CF_CHILDREN?.[String(parentId)] ?? CF_CHILDREN?.[Number(parentId)] ?? [];
    return Array.isArray(children) ? children.map(Number).filter(Number.isFinite) : [];
}

function cfExpandIds(seedIds) {
    const expanded = new Set();
    (seedIds || []).forEach(id => {
        const num = Number(id);
        if (Number.isFinite(num) && !expanded.has(num)) {
            expanded.add(num);
        }
    });

    const queue = [...expanded].filter(id => !CF_PORTFOLIO_IDS.has(id));
    while (queue.length > 0) {
        const parentId = queue.shift();
        cfChildIds(parentId).forEach(childId => {
            if (!expanded.has(childId)) {
                expanded.add(childId);
                queue.push(childId);
            }
        });
    }

    return [...expanded];
}

function cfSetSelectionState(seedIds, shouldSelect) {
    cfExpandIds(seedIds).forEach(id => {
        if (shouldSelect) {
            cfPending.add(id);
        } else {
            cfPending.delete(id);
        }
    });
}

function cfOpenModal() {
    cfPending = new Set(@Html.Raw(selectedJson));
    cfSearch  = '';
    cfActivePf = null;
    document.getElementById('cf-search').value = '';
    cfRefresh();
    document.getElementById('cf-overlay').hidden = false;
    document.getElementById('cf-search').focus();
}

function cfCloseModal(apply) {
    document.getElementById('cf-overlay').hidden = true;
    if (!apply) return;
    applyFilters(0, [...cfPending], SHOW_DOMAIN_FILTER ? [...dfPending] : null);
}

function cfOnSearch(val) {
    cfSearch  = (val || '').toLowerCase().trim();
    cfActivePf = null;
    cfRefresh();
}

function cfMatchesSearch(company) {
    if (!cfSearch) return true;
    const companyName = company && typeof company === 'object'
        ? ((company.displayName || company.companyName || '') + '').toLowerCase()
        : (company || '').toLowerCase();
    return companyName.includes(cfSearch);
}

function cfClearSearch() {
    const search = document.getElementById('cf-search');
    if (!search) return;
    search.value = '';
    cfSearch = '';
    cfActivePf = null;
    cfRefresh();
    search.focus();
}

function cfSetActivePf(pf) {
    cfActivePf = pf;
    cfRefresh();
}

function cfToggleCompany(coId) {
    const id = Number(coId);
    if (!Number.isFinite(id)) return;
    const shouldSelect = !cfPending.has(id);
    cfSetSelectionState([id], shouldSelect);
    cfRefresh();
}

function cfToggleAll() {
    const vis = cfVisibleCompanies();
    const allSel = vis.length > 0 && vis.every(c => cfPending.has(c.organizationId));
    cfSetSelectionState(vis.map(c => c.organizationId), !allSel);
    cfRefresh();
}

function cfTogglePortfolio(pf) {
    const grp = CF_GROUPS.find(g => g.portfolioName === pf);
    if (!grp) return;
    const vis = grp.companies.filter(c => cfMatchesSearch(c));
    const allSel = vis.every(c => cfPending.has(c.organizationId));
    cfSetSelectionState(vis.map(c => c.organizationId), !allSel);
    cfRefresh();
}

function cfVisibleCompanies() {
    return CF_GROUPS
        .filter(g => !cfActivePf || g.portfolioName === cfActivePf)
        .flatMap(g => g.companies)
        .filter(c => cfMatchesSearch(c));
}

function cfRefresh() {
    const vis   = cfVisibleCompanies();
    const allSel = vis.length > 0 && vis.every(c => cfPending.has(c.organizationId));

    // select-all checkbox
    const chkAll = document.getElementById('cf-chk-all');
    chkAll.checked       = allSel;
    chkAll.indeterminate = !allSel && vis.some(c => cfPending.has(c.organizationId));
    document.getElementById('cf-sa-label').textContent = cfSearch ? 'Select all matching' : 'Select all organizations';
    document.getElementById('cf-sa-hint').textContent  = vis.length + ' organizat' + (vis.length === 1 ? 'ion' : 'ions');

    // sidebar
    if (CF_SIDEBAR) {
        document.querySelectorAll('.cf-sb-item,.cf-sb-all').forEach(el => el.classList.remove('cf-sb-active'));
        const activeEl = cfActivePf
            ? document.querySelector(`.cf-sb-item[data-pf="${CSS.escape(cfActivePf)}"]`)
            : document.getElementById('cf-sb-all');
        if (activeEl) activeEl.classList.add('cf-sb-active');

        CF_GROUPS.forEach(g => {
            const cnt = g.companies.filter(c => cfPending.has(c.organizationId)).length;
            const badge = document.querySelector(`.cf-sb-badge[data-pf-badge="${CSS.escape(g.portfolioName)}"]`);
            if (badge) { badge.hidden = cnt === 0; badge.textContent = cnt || ''; }
        });
    }

    // sections / rows
    let anyVisible = false;
    CF_GROUPS.forEach(g => {
        const section = document.querySelector(`.cf-pf-section[data-section="${CSS.escape(g.portfolioName)}"]`);
        if (!section) return;
        const showSection = (!cfActivePf || cfActivePf === g.portfolioName);
        const visInGrp = g.companies.filter(c => cfMatchesSearch(c));
        section.hidden = !showSection || visInGrp.length === 0;
        if (!section.hidden) anyVisible = true;

        // per-portfolio count + selall label
        const selCnt  = g.companies.filter(c => cfPending.has(c.organizationId)).length;
        const countEl = document.querySelector(`[data-pf-count="${CSS.escape(g.portfolioName)}"]`);
        if (countEl) countEl.textContent = selCnt + ' / ' + g.companies.length + ' selected';
        const selAllBtn = document.querySelector(`[data-pf-selall="${CSS.escape(g.portfolioName)}"]`);
        if (selAllBtn) selAllBtn.textContent = visInGrp.every(c => cfPending.has(c.organizationId)) && visInGrp.length > 0 ? 'Deselect all' : 'Select all';

        g.companies.forEach(co => {
            const row  = section.querySelector(`.cf-co-row[data-company-id="${CSS.escape(String(co.organizationId))}"]`);
            if (!row) return;
            const show = showSection && cfMatchesSearch(co);
            row.hidden = !show;
            const chk  = cfPending.has(co.organizationId);
            row.classList.toggle('cf-co-checked', chk);
            const box = row.querySelector('input[type=checkbox]');
            if (box) box.checked = chk;
        });
    });

    document.getElementById('cf-empty').hidden = anyVisible;
    const searchClear = document.getElementById('cf-search-clear');
    if (searchClear) searchClear.hidden = !cfSearch;

    // footer count
    const n = cfPending.size;
    const ftEl = document.getElementById('cf-ft-count');
    ftEl.innerHTML = n === 0 ? 'No filter - showing all organizations'
        : n === CF_ALL.length ? 'All organizations selected'
        : '<strong>' + n + '</strong> organizat' + (n === 1 ? 'ion' : 'ions') + ' selected';

    updateFilterControlStates();
}

function cfClearPending() { cfPending = new Set(); cfRefresh(); }
    </text>
}

@if (showDomainFilter)
{
    <text>
const DF_ALL = @Html.Raw(domainsJson);
let   dfPending = new Set(@Html.Raw(selectedDomainsJson));
let   dfAllowAutoOpen = false;

function dfCurrentQuery() {
    const input = document.getElementById('fl-domain');
    return input ? normalizeDomainInput(input.value) : '';
}

function dfMatches() {
    const q = dfCurrentQuery();
    if (!q) return [];
    return DF_ALL.filter(d => normalizeDomainInput(d).startsWith(q));
}

function dfSetDropdownState(open) {
    const dropdown = document.getElementById('df-dropdown');
    const input = document.getElementById('fl-domain');
    if (dropdown) dropdown.hidden = !open;
    if (input) input.setAttribute('aria-expanded', open ? 'true' : 'false');
}

function dfToggleDomain(domain) {
    const d = normalizeDomainInput(domain);
    if (!d) return;
    dfPending.has(d) ? dfPending.delete(d) : dfPending.add(d);
    dfRefresh();
    applyFilters(0, null, [...dfPending]);
}

function dfSelectExactMatch() {
    const q = dfCurrentQuery();
    if (!q) return false;
    const exact = DF_ALL.find(d => normalizeDomainInput(d) === q);
    const match = exact || (dfMatches().length === 1 ? dfMatches()[0] : null);
    if (!match) return false;
    const norm = normalizeDomainInput(match);
    return true;
}

function dfHandleKeydown(event) {
    if (!event || event.key !== 'Enter') return;
    event.preventDefault();
    dfRefresh();
}

function dfRefresh() {
    const input = document.getElementById('fl-domain');
    const dropdown = document.getElementById('df-dropdown');
    const list = document.getElementById('df-dropdown-list');
    const count = document.getElementById('df-dropdown-count');
    const chips = document.getElementById('df-chips');
    const matches = dfMatches();
    const query = dfCurrentQuery();

    if (dropdown && list) {
        if (!query || matches.length === 0) {
            list.innerHTML = '';
            if (count) count.textContent = '';
            dfSetDropdownState(false);
        } else {
            list.innerHTML = '';
            matches.forEach(domain => {
                const norm = normalizeDomainInput(domain);
                const row = document.createElement('button');
                row.type = 'button';
                row.className = 'df-option' + (dfPending.has(norm) ? ' df-option-checked' : '');
                row.innerHTML = '<input type="checkbox" tabindex="-1" ' + (dfPending.has(norm) ? 'checked ' : '') + 'aria-hidden="true"><span>' + domain.replace(/^@@+/, '') + '</span>';
                row.addEventListener('mousedown', e => { e.preventDefault(); dfToggleDomain(domain); });
                list.appendChild(row);
            });
            if (count) count.textContent = matches.length + ' match' + (matches.length === 1 ? '' : 'es');
            dfSetDropdownState(dfAllowAutoOpen);
        }
    }

    if (chips) {
        chips.innerHTML = '';
        [...dfPending].sort().forEach(d => {
            const chip = document.createElement('span');
            chip.className = 'cf-chip';
            const label = document.createElement('span');
            label.textContent = d;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('aria-label', 'Remove domain');
            btn.textContent = 'x';
            btn.addEventListener('click', () => dfRemoveDomain(d));
            chip.appendChild(label);
            chip.appendChild(btn);
            chips.appendChild(chip);
        });
    }

    toggleDomainClear();
    updateFilterControlStates();
}

function dfRemoveDomain(domain) {
    const d = normalizeDomainInput(domain);
    if (!d) return;
    dfPending.delete(d);
    dfRefresh();
    applyFilters(0, null, [...dfPending]);
}

function dfClearPending() { dfPending = new Set(); dfRefresh(); }

document.addEventListener('click', e => {
    const wrap = document.querySelector('.domain-filter-wrap');
    if (!wrap) return;
    const dropdown = document.getElementById('df-dropdown');
    if (dropdown && !wrap.contains(e.target)) {
        dfSetDropdownState(false);
    }
});
    </text>
}

function validateAndApply() {
    toggleDateClear();
    toggleMonthlyReportButton();

    const fromInput = document.getElementById('fl-from');
    const toInput   = document.getElementById('fl-to');
    const errFrom   = document.getElementById('err-from');
    const errTo     = document.getElementById('err-to');
    if (!fromInput || !toInput) return;

    const from = fromInput.value;
    const to   = toInput.value;
    let valid  = true;

    // Reset errors
    if (errFrom) errFrom.textContent = '';
    if (errTo) errTo.textContent   = '';
    fromInput.classList.remove('date-invalid');
    toInput.classList.remove('date-invalid');

    // Validate From Date
    if (from && from > today) {
        if (errFrom) errFrom.textContent = 'From date cannot be in the future.';
        fromInput.classList.add('date-invalid');
        valid = false;
    }

    // Validate To Date
    if (to && to > today) {
        if (errTo) errTo.textContent = 'To date cannot be in the future.';
        toInput.classList.add('date-invalid');
        valid = false;
    }

    // Validate range
    if (from && to && from > to) {
        if (errTo) errTo.textContent = 'To date must be on or after From date.';
        toInput.classList.add('date-invalid');
        valid = false;
    }

    if (!valid) return;

    // Only filter by date when BOTH dates are set. If a date range is already
    // applied and the user breaks the pair, re-apply to remove the date filter.
    if (from && to) {
        applyFilters();
    } else if (DATE_FILTER_ACTIVE && !from && !to) {
        applyFilters();
    }
}

function normalizeDomainInput(value) {
    return (value || '').trim().replace(/^@@+/, '').toLowerCase();
}

function validateDomain() {
    const domainInput = document.getElementById('fl-domain');
    const errDomain = document.getElementById('err-domain');
    if (!domainInput || !errDomain) return true;

    const raw = domainInput.value.trim();
    const domain = normalizeDomainInput(raw);
    const isValid = !raw || /^[a-z0-9][a-z0-9.\-]*$/i.test(domain);

    errDomain.textContent = isValid ? '' : 'Enter a valid domain, such as example.com.';
    domainInput.classList.toggle('date-invalid', !isValid);
    return isValid;
}

function validateDomainAndApply() {
