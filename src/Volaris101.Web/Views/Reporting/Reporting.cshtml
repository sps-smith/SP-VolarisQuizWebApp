function clearDates() {
    const fromInput = document.getElementById('fl-from');
    const toInput = document.getElementById('fl-to');
    const errFrom = document.getElementById('err-from');
    const errTo = document.getElementById('err-to');
    if (!fromInput || !toInput || !errFrom || !errTo) return;

    fromInput.value = '';
    toInput.value   = '';
    errFrom.textContent = '';
    errTo.textContent   = '';
    fromInput.classList.remove('date-invalid');
    toInput.classList.remove('date-invalid');
    toggleDateClear();
    toggleMonthlyReportButton();
    applyFilters();
}

// Show the "Clear dates" button only when at least one date is entered
function toggleDateClear() {
    const fromInput = document.getElementById('fl-from');
    const toInput   = document.getElementById('fl-to');
    const btn  = document.getElementById('date-clear-btn');
    if (!btn || !fromInput || !toInput) return;
    btn.hidden = !(fromInput.value || toInput.value);
    updateFilterControlStates();
}

function toggleMonthlyReportButton() {
    const btn = document.getElementById('monthly-report-btn');
    if (!btn) return;
    const fromInput = document.getElementById('fl-from');
    const toInput = document.getElementById('fl-to');
    if (!fromInput || !toInput) return;
    const from = fromInput.value;
    const to   = toInput.value;
    const valid = !!(from && to && from <= to && from <= today && to <= today);
    btn.disabled = !valid;
}

function updateFilterControlStates() {
    const searchInput = document.getElementById('fl-search');
    const domainInput = document.getElementById('fl-domain');
    const moduleInput = document.getElementById('fl-module');
    const fromInput = document.getElementById('fl-from');
    const toInput = document.getElementById('fl-to');
    const orgTrigger = document.getElementById('cf-trigger');
    const statusTrigger = document.getElementById('sf-trigger');

    if (searchInput) {
        searchInput.classList.toggle('filter-active', !!searchInput.value.trim());
    }

    if (domainInput) {
        domainInput.classList.toggle('filter-active', typeof dfPending !== 'undefined' && dfPending.size > 0);
    }

    if (moduleInput) {
        moduleInput.classList.toggle('filter-active', !!moduleInput.value);
    }

    const hasFullDateRange = !!(fromInput && toInput && fromInput.value && toInput.value);
    if (fromInput) {
        fromInput.classList.toggle('filter-active', hasFullDateRange);
    }
    if (toInput) {
        toInput.classList.toggle('filter-active', hasFullDateRange);
    }

    if (statusTrigger) {
        statusTrigger.classList.toggle('filter-active', typeof sfPending !== 'undefined' && sfPending.size > 0 && sfPending.size < 3);
    }

    if (orgTrigger) {
        const totalCompanies = typeof CF_ALL !== 'undefined' ? CF_ALL.length : 0;
        const hasCompanyFilter = typeof cfPending !== 'undefined' && cfPending.size > 0 && (totalCompanies === 0 || cfPending.size < totalCompanies);
        orgTrigger.classList.toggle('filter-active', hasCompanyFilter);
    }
}

function toggleSearchClear() {
    const search = document.getElementById('fl-search');
    const clear = document.getElementById('fl-search-clear');
    if (!search || !clear) return;
    clear.hidden = !search.value;
    updateFilterControlStates();
}

function toggleDomainClear() {
    const domain = document.getElementById('fl-domain');
    const clear = document.getElementById('fl-domain-clear');
    if (!domain || !clear) return;
    clear.hidden = !(domain.value || (typeof dfPending !== 'undefined' && dfPending.size > 0));
