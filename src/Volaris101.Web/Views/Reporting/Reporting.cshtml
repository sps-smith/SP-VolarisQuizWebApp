function toggleExportOptions() {
    const panel = document.getElementById('export-options');
    const trigger = document.getElementById('export-link');
    if (!panel || !trigger) return;
    const isOpen = panel.classList.contains('open');
    const timerKey = '__hideTimer';

    if (panel[timerKey]) {
        clearTimeout(panel[timerKey]);
        panel[timerKey] = null;
    }

    if (!isOpen) {
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('open'));
        trigger.setAttribute('aria-expanded', 'true');
        return;
    }

    panel.classList.remove('open');
    trigger.setAttribute('aria-expanded', 'false');
    panel[timerKey] = window.setTimeout(() => {
        panel.hidden = true;
        panel[timerKey] = null;
    }, 180);
}

